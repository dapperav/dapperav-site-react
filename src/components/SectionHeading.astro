---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  /** 1 = the page's hero heading: renders an h1 and skips the reveal animation */
  level?: 1 | 2;
}

const { eyebrow, title, lead, align = 'center', tone = 'light', level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const reveal = level === 1 ? undefined : '';
const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
const titleCls = tone === 'dark' ? 'text-cream' : 'text-espresso';
const leadCls = tone === 'dark' ? 'text-cream/70' : 'text-cocoa';
---

<div class={`max-w-2xl ${alignCls}`}>
  <p
    class={`flex items-center gap-3 text-xs font-semibold tracking-[0.28em] ${tone === 'dark' ? 'text-gold' : 'text-gold-ink'} uppercase ${align === 'center' ? 'justify-center' : ''}`}
    data-reveal={reveal}
  >
    <span class="block h-2 w-2 rounded-full bg-gold" aria-hidden="true"></span>
    {eyebrow}
    {align === 'center' && <span class="block h-2 w-2 rounded-full bg-gold" aria-hidden="true" />}
  </p>
  <Heading
    class={`font-display mt-4 text-3xl leading-tight font-semibold text-balance sm:text-4xl lg:text-[2.75rem] ${titleCls}`}
    data-reveal={reveal}
    style="--rd: 80ms"
  >
    {title}
  </Heading>
  {
    lead && (
      <p class={`mt-5 text-base leading-relaxed sm:text-lg ${leadCls}`} data-reveal={reveal} style="--rd: 160ms">
        {lead}
      </p>
    )
  }
</div>
