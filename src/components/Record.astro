---
/**
 * Faint concentric groove rings — a quiet nod to the vinyl in the logo, used behind
 * cream page headers. Decorative only. Position it with `class` inside a `relative` parent.
 * (The big dark record was retired 2026-11-18: it read as a music store.)
 */
interface Props {
  class?: string;
}

const { class: cls = '' } = Astro.props;
const grooves = Array.from({ length: 30 }, (_, i) => 118 + i * 6);
const trackGaps = [166, 214, 256];
---

<div class={`record ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
    {
      grooves.map((r, i) => (
        <circle cx="300" cy="300" r={r} fill="none" stroke="currentColor" stroke-opacity={0.1 + (i % 3) * 0.04} stroke-width="1" />
      ))
    }
    {trackGaps.map((r) => <circle cx="300" cy="300" r={r} fill="none" stroke="currentColor" stroke-opacity="0.3" stroke-width="2.5" />)}
    <circle cx="300" cy="300" r="296" fill="none" stroke="currentColor" stroke-opacity="0.4" stroke-width="2" />
    <circle cx="300" cy="300" r="112" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="2" />
  </svg>
</div>
