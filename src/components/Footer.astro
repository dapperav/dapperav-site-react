---
/** Roast footer: brand, ways to reach, pages, then credits for every found and gear photo. */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { areas } from '../data/areas';
import { industries } from '../data/industries';
import found from '../assets/found/credits.json';
import gearCredits from '../../design-system/gear/credits.json';

type Credit = { title: string; creator?: string | null; license: string; licenseUrl?: string | null; page: string; via?: string | null };
const pictures = [...(gearCredits as Credit[]), ...(found as Credit[])];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={logo} alt="" width={144} loading="lazy" />
      <p class="footer-name">{site.name}</p>
      <p>Commercial AV and managed IT for Fort Bend County businesses. Homes too. Based in Richmond, Texas.</p>
    </div>
    <div>
      <h2 class="footer-head">Reach me</h2>
      <ul class="footer-list">
        <li><a href={site.phoneHref}>{site.phone}</a> <span>call or text</span></li>
        <li><a href={site.smsHref}>Text a photo of the space</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>Mon–Fri 8am–6pm<br />Evenings and weekends by appointment</li>
      </ul>
    </div>
    <div>
      <h2 class="footer-head">For business</h2>
      <ul class="footer-list">
        <li><a href="/business/">Managed IT &amp; care plans</a></li>
        {industries.map((i) => <li><a href={`/business/${i.slug}/`}>{i.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-head">More</h2>
      <ul class="footer-list">
        <li><a href="/services/">For homes</a></li>
        <li><a href="/work/">Our work</a></li>
        <li><a href="/quote/">Book a site survey</a></li>
      </ul>
      <h2 class="footer-head footer-head--gap">Where I work</h2>
      <ul class="footer-social">
        {areas.map((a) => <li><a href={`/areas/${a.slug}/`}>{a.city}</a></li>)}
      </ul>
      <ul class="footer-social">
        {site.socials.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container">
    <details class="footer-credits-wrap">
      <summary>Photo credits</summary>
    <p class="footer-credits">
      Photos of equipment and of Fort Bend County are not Dapper AV jobs; they are other people's pictures, used
      under their licences:
      {
        pictures.map((p, i) => (
          <>
            {' '}<a href={p.page}>{p.title}</a>
            {p.creator ? ` by ${p.creator}` : ''}, {p.licenseUrl ? <a href={p.licenseUrl}>{p.license}</a> : p.license}
            {p.via ? `, via ${p.via}` : ''}
            {i < pictures.length - 1 ? ';' : '.'}
          </>
        ))
      }
      {' '}Every install photo that says it is a Dapper AV job is one.
    </p>
    </details>
  </div>
  <div class="container footer-legal">
    <p>© {year} {site.name}, Richmond, Texas.</p>
    <a href="#main">Back to top</a>
  </div>
</footer>
