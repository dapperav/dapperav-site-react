---
/** Footer: brand and how to reach us, four link columns, then one legal line (privacy, photo credits, back to top). */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { areas } from '../data/areas';
import { industries } from '../data/industries';
import found from '../assets/found/credits.json';
import OpenNow from './OpenNow.astro';

type Credit = { title: string; creator?: string | null; license: string; licenseUrl?: string | null; page: string; via?: string | null };
const pictures = found as Credit[];
const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Image src={logo} alt="" width={144} loading="lazy" />
        <div>
          <p class="footer-name">{site.name}</p>
          <p class="footer-tag">Commercial AV and managed IT for Fort Bend County businesses. Homes too.</p>
        </div>
      </div>
      <div class="footer-reach">
        <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
        <p>Mon–Fri 9am–5pm Central. Evenings and weekends by appointment.</p>
        <OpenNow />
      </div>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div>
        <h2 class="footer-head">For business</h2>
        <ul class="footer-list">
          <li><a href="/business/">Managed IT &amp; care plans</a></li>
          {industries.map((i) => <li><a href={`/business/${i.slug}/`}>{i.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-head">For homes</h2>
        <ul class="footer-list">
          <li><a href="/services/">Home services</a></li>
          <li><a href="/quote/">Send a request</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-head">Where we work</h2>
        <ul class="footer-list">
          {areas.map((a) => <li><a href={`/areas/${a.slug}/`}>{a.city}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-head">Follow</h2>
        <ul class="footer-list">
          {site.socials.map((s) => <li><a href={s.url} rel="noopener">{s.name}</a></li>)}
        </ul>
      </div>
    </nav>

    <div class="footer-legal">
      <p>© {year} {site.name}, Richmond, Texas.</p>
      <a href="/privacy/">Privacy</a>
      <details class="footer-credits-wrap">
        <summary>Photo credits</summary>
        <p class="footer-credits">
          Photos of Fort Bend County are other people's pictures, used under their licences:
          {
            pictures.map((p, i) => (
              <>
                {' '}<a href={p.page}>{p.title}</a>
                {p.creator ? ` by ${p.creator}` : ''}, {p.licenseUrl ? <a href={p.licenseUrl}>{p.license}</a> : p.license}
                {p.via ? `, via ${p.via}` : ''}
                {i < pictures.length - 1 ? ';' : '.'}
              </>
            ))
          }
          {' '}Every install photo that says it is a Dapper AV job is one.
        </p>
      </details>
      <a href="#main">Back to top</a>
    </div>
  </div>
</footer>
