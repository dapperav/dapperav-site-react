---
/** The six business pages as a ledger of destinations. */
import { industries } from '../data/industries';

interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const list = industries.filter((i) => i.slug !== exclude);
---

<ul class="ledger">
  {
    list.map((i, n) => (
      <li data-reveal style={`--d:${n * 50}ms`}>
        <a class="ledger-row" href={`/business/${i.slug}/`}>
          <span class="ledger-name">{i.name.replace(/Wi-Fi/g, 'Wi‑Fi')}</span>
          <span class="ledger-line">{i.installs.slice(0, 2).join('. ')}.</span>
          <span class="ledger-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      </li>
    ))
  }
</ul>
