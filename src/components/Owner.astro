---
/** The owner, told in words and real facts (no portrait: Mark's call, 2026-11-19). */
interface Props {
  heading?: string;
  lede?: string;
  alt?: boolean;
  id?: string;
}
const {
  heading = 'An installer who also runs IT',
  lede = "I'm Mark Immler, and Dapper AV is mine. The person who surveys your site is the person who installs it, and the one who looks after it afterward.",
  alt = true,
  id = 'owner',
} = Astro.props;
---

<section class:list={['section', { 'section--alt': alt }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="container owner">
    <div class="owner-copy">
      <h2 class="h2" id={`${id}-title`}>{heading}</h2>
      <p class="lede">{lede}</p>
      <p class="owner-areas">Serving Richmond, Rosenberg, Fulshear, Sugar Land, Stafford, Katy and the rest of Fort Bend County.</p>
      <p class="signature">Mark Immler<span>Owner, Dapper AV Solutions</span></p>
    </div>
    <dl class="facts facts--big" data-reveal>
      <div>
        <dt>Installing AV</dt>
        <dd>18 years</dd>
      </div>
      <div>
        <dt>Running managed IT</dt>
        <dd>5 years</dd>
      </div>
      <div>
        <dt>Day job</dt>
        <dd>IT director</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>Richmond</dd>
      </div>
    </dl>
  </div>
</section>
