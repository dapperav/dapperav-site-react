---
/** Industries as a 3 x 2 grid of photo link cards (homepage, /business). */
import { Image } from 'astro:assets';
import { industries } from '../data/industries';
import { gear, industryThumb } from '../data/gear';
import { industryLines as lines } from '../data/industryLines';
interface Props { heading?: string; lede?: string; alt?: boolean; exclude?: string; }
const { heading = 'Who we work with', lede = 'Six kinds of business, each with its own page: what we install there and what moves the price.', alt = true, exclude } = Astro.props;
const shown = industries.filter((i) => i.slug !== exclude);
---

<section class:list={["section", { "section--alt": alt }]} id="industries" aria-labelledby="industries-title">
  <div class="container">
    <div class="home-head">
      <h2 class="h2" id="industries-title">{heading}</h2>
      <p class="lede">{lede}</p>
    </div>
    <ul class="home-grid">
      {
        shown.map((i) => (
          <li>
            <a class="home-card link-card" href={`/business/${i.slug}/`}>
              <div class="home-card-media">
                <Image src={gear[industryThumb[i.slug]].image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" />
              </div>
              <h3>{i.name.replace(/Wi-Fi/g, 'Wi‑Fi')}</h3>
              <p>{lines[i.slug] ?? i.installs[0]}</p>
              <span class="home-card-go">See what we install</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
