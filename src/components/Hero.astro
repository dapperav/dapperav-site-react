---
/**
 * Page hero. tone="dark": espresso + pinstripe + gold headline (the original look).
 * tone="light": paper + groove arcs, brown headline. The one <h1> on the page lives here
 * (except /quote/, whose form heading is its h1). Slots: "crumbs", "aside" (side panel), default (a line under the actions).
 */
interface Action {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  arrow?: boolean;
}
interface Props {
  tone?: 'dark' | 'light';
  alt?: boolean;
  page?: boolean;
  center?: boolean;
  lead?: string;
  main: string;
  lede?: string;
  actions?: Action[];
  id?: string;
}
const { tone = 'dark', alt = false, page = true, center = false, lead, main, lede, actions = [], id = 'top' } = Astro.props;
const hasAside = Astro.slots.has('aside');
const dark = tone === 'dark';
---

<section
  class:list={['hero', dark ? 'on-dark pinstripe' : 'hero--light grooves', { 'hero--alt': alt, 'hero--page': page, 'hero--center': center }]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class:list={['container', 'hero-grid', { 'hero-grid--solo': !hasAside }]}>
    <div class="hero-copy">
      <slot name="crumbs" />
      <h1 class="hero-title" id={`${id}-title`}>
        {lead && <span class="hero-title-lead">{lead}</span>}
        <span class="hero-title-main">{main.replace(/Wi-Fi/g, 'Wi‑Fi')}</span>
      </h1>
      {lede && <p class="hero-lede">{lede}</p>}
      {
        actions.length > 0 && (
          <div class="hero-actions">
            {actions.map((a) => (
              <a class={`btn btn--${a.variant ?? 'primary'} btn--lg`} href={a.href}>
                {a.label}
                {a.arrow && (
                  <span class="btn-orb" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                )}
              </a>
            ))}
          </div>
        )
      }
      <slot />
    </div>
    {hasAside && <div class="hero-side"><slot name="aside" /></div>}
  </div>
</section>
