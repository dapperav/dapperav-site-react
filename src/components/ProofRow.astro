---
/** Proof: one real Google review card beside the owner facts card. */
import reviewsData from '../data/reviews.json';
interface Props { alt?: boolean; }
const { alt = true } = Astro.props;
const review = (reviewsData.reviews as { author: string; rating: number; text: string }[]).find((r) => r.author.startsWith('Micaela'));
const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${reviewsData.placeId}`;
---

<section class:list={["section", { "section--alt": alt }]} id="proof" aria-labelledby="proof-title">
  <div class="container">
    <div class="home-head">
      <h2 class="h2" id="proof-title">AV and IT under one roof</h2>
      <p class="lede">Founded by Mark Immler. The survey, the install and the support all come from Dapper AV, never a subcontractor.</p>
    </div>
    <div class="home-proof">
      {
        review && (
          <figure class="home-quote">
            <span class="home-stars" aria-label="5 out of 5 stars">★★★★★</span>
            <blockquote>
              <p>{review.text}</p>
            </blockquote>
            <figcaption>
              <strong>{review.author}</strong> · Google review · Business ·{' '}
              <a class="text-link" href={mapsUrl}>Read every review on Google</a>
            </figcaption>
          </figure>
        )
      }
      <dl class="home-facts">
        <div><dt>Installing AV</dt><dd>18 years</dd></div>
        <div><dt>Running managed IT</dt><dd>5 years</dd></div>
        <div><dt>Based in Fort Bend County</dt><dd>Richmond</dd></div>
      </dl>
    </div>
  </div>
</section>
