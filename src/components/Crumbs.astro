---
/** Breadcrumb trail (wayfinding, not a label). The last item is the current page. */
interface Props {
  items: { href?: string; label: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="crumbs">
    {items.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
  </ol>
</nav>
