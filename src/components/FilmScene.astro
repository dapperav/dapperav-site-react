---
/**
 * A scene from the brand film ("Behind it"), played on the page: something is broken, the dapper
 * installer passes through, then it works and a title credit lands ("TVs & sound / by Dapper AV").
 * Silhouettes are the film's own generated illustrations (public/film/*.png, used as masks).
 * Without JS, or with reduced motion, the scene simply shows its fixed state.
 */
interface Props {
  kind: 'bar' | 'menu' | 'office' | 'home' | 'shop' | 'ladder';
  credit: string;
  label: string;
  class?: string;
}
const { kind, credit, label, class: cls } = Astro.props;
const screens = kind === 'bar' || kind === 'menu' ? [0, 1, 2] : [];
const people = { bar: 'bar', menu: 'bar', office: 'office', home: 'family', shop: null, ladder: null }[kind];
const stripes = Array.from({ length: 10 }, (_, i) => i);
---

<figure class:list={['fscene', `fscene--${kind}`, cls]} data-scene role="img" aria-label={label}>
  <div class="fs-stage">
    {
      screens.length > 0 && (
        <div class="fs-screens">
          {screens.map((i) => (
            <div class="fs-tv" style={`--i:${i}`}>
              <span class="fs-nosignal">No signal</span>
              <span class="fs-lit">
                {kind === 'bar' ? (
                  <>
                    <i class="fs-pitch-line" />
                    <i class="fs-pitch-circle" />
                    <i class="fs-ball" />
                  </>
                ) : (
                  <>
                    <i class="fs-menu-row" />
                    <i class="fs-menu-row" />
                    <i class="fs-menu-row" />
                  </>
                )}
              </span>
            </div>
          ))}
        </div>
      )
    }

    {
      kind === 'office' && (
        <>
          <div class="fs-ap">
            <i class="fs-ap-dot" />
            <i class="fs-ring fs-ring--1" />
            <i class="fs-ring fs-ring--2" />
            <i class="fs-ring fs-ring--3" />
          </div>
          <div class="fs-status">
            <i class="fs-spinner" />
            <svg class="fs-check" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
          </div>
        </>
      )
    }

    {
      kind === 'home' && (
        <>
          <div class="fs-window" />
          <div class="fs-hometv">
            <span class="fs-lit fs-lit--home">
              <i class="fs-hill" />
            </span>
          </div>
        </>
      )
    }

    {
      kind === 'shop' && (
        <div class="fs-shop">
          <div class="fs-awning">
            {stripes.map(() => (
              <i />
            ))}
          </div>
          <div class="fs-front">
            <i class="fs-door" />
          </div>
          <div class="fs-cam">
            <i class="fs-cam-arm" />
            <i class="fs-cam-head" />
            <i class="fs-cam-led" />
          </div>
        </div>
      )
    }

    {
      kind === 'ladder' && (
        <div class="fs-roundel">
          <span class="fs-sil fs-ladderman" />
        </div>
      )
    }

    {people && <span class={`fs-sil fs-people fs-people--${people}`} />}
    {kind !== 'ladder' && <span class="fs-walker" />}

    <figcaption class="fs-credit">
      <span class="fs-credit-big">{credit}</span>
      <span class="fs-credit-small">by Dapper AV</span>
    </figcaption>
  </div>
</figure>

<script>
  // Each scene plays once, when most of it is on screen.
  const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('scenes');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-on');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.55 },
    );
    scenes.forEach((s) => io.observe(s));
  }
</script>

<style is:global>
  /* ── film scene: stage ── */
  .fscene {
    margin: 0;
  }
  .fs-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    background: var(--brown-900);
    isolation: isolate;
    container-type: inline-size;
  }
  .fscene--office .fs-stage {
    background: var(--cream-50);
  }
  .fscene--home .fs-stage {
    background: #4a1708;
  }
  .fscene--shop .fs-stage {
    background: #1d0702;
  }
  .fscene--ladder .fs-stage {
    background: var(--brown-900);
  }

  /* silhouettes are masks so they take the brand's ink */
  .fs-sil,
  .fs-walker {
    position: absolute;
    display: block;
    background: #120401;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }
  .fs-people {
    left: 4%;
    right: 4%;
    bottom: 0;
    aspect-ratio: 1400 / 799;
    z-index: 2;
  }
  .fs-people--bar {
    -webkit-mask-image: url(/film/bar.png);
    mask-image: url(/film/bar.png);
  }
  .fs-people--office {
    -webkit-mask-image: url(/film/office.png);
    mask-image: url(/film/office.png);
  }
  .fs-people--family {
    -webkit-mask-image: url(/film/family.png);
    mask-image: url(/film/family.png);
    left: 14%;
    right: 14%;
  }

  /* the installer: one stepped mask sprite of eight stride poses */
  .fs-walker {
    left: 0;
    bottom: 2%;
    width: 30%;
    aspect-ratio: 1;
    z-index: 3;
    background: var(--color-accent);
    -webkit-mask-image: url(/film/walk.png);
    mask-image: url(/film/walk.png);
    -webkit-mask-size: 800% 100%;
    mask-size: 800% 100%;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
    opacity: 0;
    pointer-events: none;
  }
  .fscene--shop .fs-walker {
    background: #120401;
  }
  .fscene--office .fs-walker {
    background: color-mix(in srgb, #120401 35%, transparent);
  }

  /* ── title credit, film style ── */
  .fs-credit {
    position: absolute;
    top: 7%;
    right: 6%;
    z-index: 4;
    display: grid;
    justify-items: end;
    text-align: right;
    color: var(--cream-50);
  }
  .fscene--office .fs-credit {
    color: var(--brown-900);
  }
  .fscene--ladder .fs-credit {
    right: auto;
    left: 6%;
    justify-items: start;
    text-align: left;
  }
  .fs-credit-big {
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: clamp(1rem, 6.2cqw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .fs-credit-small {
    margin-top: 0.25em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.75rem, 2.6cqw, 1rem);
    color: var(--color-accent);
  }
  .fscene--office .fs-credit-small {
    color: var(--color-accent-ink);
  }

  /* ── bar / menu: three screens ── */
  .fs-screens {
    position: absolute;
    top: 8%;
    left: 5%;
    width: 54%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4%;
    z-index: 1;
  }
  .fs-tv {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    background: #2a1610;
    outline: 3px solid #0d0301;
    overflow: hidden;
  }
  .fs-nosignal {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(0.5rem, 0.9vw, 0.6875rem);
    color: color-mix(in srgb, var(--cream-50) 55%, transparent);
  }
  .fs-lit {
    position: absolute;
    inset: 0;
    background: #3f7d4e;
  }
  .fs-pitch-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: color-mix(in srgb, #fff 70%, transparent);
  }
  .fs-pitch-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34%;
    aspect-ratio: 1;
    border: 2px solid color-mix(in srgb, #fff 70%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .fs-ball {
    position: absolute;
    left: 70%;
    top: 40%;
    width: 7%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
  }
  .fscene--menu .fs-lit {
    display: grid;
    align-content: center;
    gap: 12%;
    padding: 0 14%;
    background: var(--brown-900);
  }
  .fs-menu-row {
    display: block;
    height: 0.35rem;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .fs-menu-row:nth-child(2) {
    width: 70%;
    background: var(--cream-50);
  }
  .fs-menu-row:nth-child(3) {
    width: 85%;
    background: var(--cream-50);
  }

  /* ── office: access point + rings, spinner turns into a check ── */
  .fs-ap {
    position: absolute;
    top: 8%;
    left: 10%;
    width: 9%;
    aspect-ratio: 1;
    z-index: 1;
  }
  .fs-ap-dot {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    outline: 2px solid #e3d4bb;
  }
  .fs-ring {
    position: absolute;
    left: 50%;
    top: 60%;
    aspect-ratio: 2 / 1;
    border: 3px solid var(--color-accent);
    border-top: 0;
    border-radius: 0 0 999px 999px;
    transform: translateX(-50%);
  }
  .fs-ring--1 {
    width: 160%;
  }
  .fs-ring--2 {
    width: 260%;
  }
  .fs-ring--3 {
    width: 360%;
  }
  .fs-status {
    position: absolute;
    top: 30%;
    left: 44%;
    width: 7%;
    aspect-ratio: 1;
    z-index: 3;
  }
  .fs-spinner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid color-mix(in srgb, #120401 20%, transparent);
    border-top-color: #120401;
    opacity: 0;
  }
  .fs-check {
    position: absolute;
    inset: -10%;
    padding: 18%;
    border-radius: 50%;
    background: var(--color-accent);
    fill: none;
    stroke: #120401;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── home: window + TV ── */
  .fs-window {
    position: absolute;
    left: 6%;
    top: 22%;
    width: 18%;
    height: 50%;
    background: #e98a1f;
    z-index: 0;
  }
  .fs-hometv {
    position: absolute;
    left: 32%;
    top: 30%;
    width: 50%;
    aspect-ratio: 16 / 9;
    background: #0d0301;
    outline: 4px solid #0d0301;
    border-radius: 4px;
    overflow: hidden;
    z-index: 1;
  }
  .fs-lit--home {
    background: #c9852a;
  }
  .fs-hill {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -55%;
    height: 100%;
    border-radius: 50%;
    background: #3f5d2e;
  }

  /* ── shop: awning, front, camera ── */
  .fs-shop {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 22%;
    bottom: 12%;
    z-index: 1;
  }
  .fs-awning {
    display: flex;
    height: 14%;
    border-radius: 6px 6px 0 0;
    overflow: hidden;
  }
  .fs-awning i {
    flex: 1;
    background: var(--cream-50);
  }
  .fs-awning i:nth-child(even) {
    background: #b8322a;
  }
  .fs-front {
    position: relative;
    height: 86%;
    background: var(--color-accent);
  }
  .fs-door {
    position: absolute;
    left: 42%;
    width: 16%;
    top: 22%;
    bottom: 0;
    background: #7a4a12;
  }
  .fs-cam {
    position: absolute;
    right: -6%;
    top: 16%;
    width: 18%;
    aspect-ratio: 2 / 1;
    transform-origin: 85% 20%;
    transform: rotate(-4deg);
  }
  .fs-cam-arm {
    position: absolute;
    right: 0;
    top: 0;
    width: 22%;
    height: 22%;
    background: #120401;
  }
  .fs-cam-head {
    position: absolute;
    left: 0;
    top: 22%;
    width: 85%;
    height: 60%;
    border-radius: 6px;
    background: #2a1610;
  }
  .fs-cam-led {
    position: absolute;
    left: 10%;
    top: 42%;
    width: 9%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #e03a2a;
  }

  /* ── ladder: the installer at work inside the gold roundel ── */
  .fs-roundel {
    position: absolute;
    right: 8%;
    top: 8%;
    bottom: 8%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent);
    overflow: hidden;
  }
  .fs-ladderman {
    left: -32%;
    bottom: 0;
    width: 164%;
    aspect-ratio: 1400 / 799;
    -webkit-mask-image: url(/film/installer-ladder.png);
    mask-image: url(/film/installer-ladder.png);
  }

  /* ══ the beat: broken, he passes, fixed, credit (only when JS can play it) ══ */
  @media (prefers-reduced-motion: no-preference) {
    /* waiting state, before the scene scrolls in */
    .scenes [data-scene]:not(.is-on) .fs-lit {
      clip-path: inset(0 0 100% 0);
    }
    .scenes [data-scene]:not(.is-on) .fs-ring {
      opacity: 0;
    }
    .scenes [data-scene]:not(.is-on) .fs-check {
      transform: scale(0);
    }
    .scenes [data-scene]:not(.is-on) .fs-spinner {
      opacity: 1;
    }
    .scenes [data-scene]:not(.is-on) .fs-credit > * {
      opacity: 0;
      transform: translateY(0.6em);
    }
    .scenes .fscene--shop:not(.is-on) .fs-cam {
      transform: rotate(-38deg);
    }
    .scenes .fscene--ladder:not(.is-on) .fs-roundel {
      transform: scale(1.35);
      opacity: 0;
    }

    /* he walks through */
    .is-on .fs-walker {
      animation:
        fs-cross 2.2s linear 0.15s both,
        fs-stride 0.6s steps(8) 0.15s 4 both;
    }
    /* screens come on one after another, wiping down like a CRT */
    .is-on .fs-lit {
      animation: fs-on 260ms var(--ease-land) both;
      animation-delay: calc(1.05s + var(--i, 0) * 120ms);
    }
    .is-on .fs-people {
      animation: fs-cheer 520ms var(--ease-land) 1.35s both;
    }
    .is-on .fs-spinner {
      animation: fs-spin 0.7s linear 0s 2, fs-gone 120ms ease-in 1.2s both;
    }
    .is-on .fs-check {
      animation: fs-pop 380ms var(--ease-land) 1.25s both;
    }
    .is-on .fs-ring {
      animation: fs-ring 420ms var(--ease-land) both;
    }
    .is-on .fs-ring--1 {
      animation-delay: 1.3s;
    }
    .is-on .fs-ring--2 {
      animation-delay: 1.42s;
    }
    .is-on .fs-ring--3 {
      animation-delay: 1.54s;
    }
    .is-on .fs-cam {
      animation: fs-snap 420ms var(--ease-land) 1.15s both;
    }
    .is-on .fs-roundel {
      animation: fs-lens 420ms var(--ease-land) both;
    }
    .is-on .fs-ladderman {
      animation: fs-work 1.6s ease-in-out 0.4s both;
    }
    .is-on .fs-credit > * {
      animation: fs-credit 400ms var(--ease-land) both;
    }
    .is-on .fs-credit-big {
      animation-delay: 1.6s;
    }
    .is-on .fs-credit-small {
      animation-delay: 1.72s;
    }
    .fscene--ladder.is-on .fs-credit-big {
      animation-delay: 0.6s;
    }
    .fscene--ladder.is-on .fs-credit-small {
      animation-delay: 0.72s;
    }
  }

  @keyframes fs-cross {
    0% {
      opacity: 1;
      transform: translateX(-100%);
    }
    100% {
      opacity: 1;
      transform: translateX(340%);
    }
  }
  @keyframes fs-stride {
    from {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
    to {
      -webkit-mask-position: 114.2857% 0;
      mask-position: 114.2857% 0;
    }
  }
  @keyframes fs-on {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes fs-cheer {
    0% {
      transform: none;
    }
    35% {
      transform: translateY(-4%);
    }
    100% {
      transform: none;
    }
  }
  @keyframes fs-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes fs-gone {
    to {
      opacity: 0;
    }
  }
  @keyframes fs-pop {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes fs-ring {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(0.6);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }
  @keyframes fs-snap {
    from {
      transform: rotate(-38deg);
    }
    to {
      transform: rotate(-4deg);
    }
  }
  @keyframes fs-lens {
    from {
      opacity: 0;
      transform: scale(1.35);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes fs-work {
    0%,
    100% {
      transform: none;
    }
    25%,
    75% {
      transform: translateY(-2.5%);
    }
    50% {
      transform: none;
    }
  }
  @keyframes fs-credit {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
