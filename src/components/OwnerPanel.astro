---
/**
 * The owner, start to finish: portrait, real facts, one paragraph and the page's reasons.
 * Real facts only (18 years installing, 5 years managed IT, IT director by day).
 */
import { Image } from 'astro:assets';
import markPortrait from '../assets/mark-portrait.jpg';

interface Props {
  title?: string;
  reasons?: { title: string; body: string }[];
}
const { title = 'One person, start to finish.', reasons = [] } = Astro.props;
---

<section class="chapter bg-parchment text-espresso" data-field="#efe3cb" data-ink="#3b1005">
  <div class="page-wrap section-pad about-grid">
    <div class="about-side">
      <Image
        src={markPortrait}
        alt="Mark Immler, owner of Dapper AV Solutions, in a blue plaid blazer"
        widths={[400, 640]}
        sizes="(min-width: 1024px) 26vw, 80vw"
        class="about-portrait"
      />
      <dl class="about-facts">
        <div><dt>Owner</dt><dd>Mark Immler</dd></div>
        <div><dt>Based in</dt><dd>Richmond, Texas</dd></div>
        <div><dt>Installing AV</dt><dd>18 years</dd></div>
        <div><dt>Running managed IT</dt><dd>5 years</dd></div>
      </dl>
    </div>
    <div class="about-main">
      <h2 class="font-display h-section">{title}</h2>
      <p class="about-para">
        I'm Mark Immler. I've installed AV for more than 18 years and my day job is IT director. The person who
        surveys your site installs it, and answers the phone when something needs looking at.
      </p>
      {
        reasons.length > 0 && (
          <dl class="reasons">
            {reasons.map((r) => (
              <div data-reveal>
                <dt class="font-display">{r.title}</dt>
                <dd>{r.body}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
