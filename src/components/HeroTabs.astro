---
/**
 * Homepage hero: pick your kind of business and the picture below swaps to that industry's photo (gear and
 * kinds of rooms, never presented as Dapper AV jobs) with a dark-glass panel of what we install there and a
 * link to its page. Without JS the first panel shows and the six pages are linked below.
 */
import { Image } from 'astro:assets';
import { industries } from '../data/industries';
import { industryLines } from '../data/industryLines';
import { gear, industryThumb } from '../data/gear';

const short: Record<string, string> = {
  'restaurants-bars': 'Restaurants',
  'offices-conference-rooms': 'Offices',
  'retail-showrooms': 'Retail',
  'digital-signage': 'Signage',
  'networks-wifi': 'Wi‑Fi',
  'structured-cabling': 'Cabling',
};
---

<div class="htabs" data-htabs>
  <div class="pill-tabs" role="tablist" aria-label="Pick your kind of business">
    {
      industries.map((i, n) => (
        <button class="pill" type="button" role="tab" id={`htab-${i.slug}`} aria-controls={`hpanel-${i.slug}`} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1}>
          {short[i.slug] ?? i.name}
        </button>
      ))
    }
  </div>
  <div class="htabs-stage">
    {
      industries.map((i, n) => {
        const g = gear[industryThumb[i.slug]];
        return (
          <div class="htabs-panel" role="tabpanel" id={`hpanel-${i.slug}`} aria-labelledby={`htab-${i.slug}`} hidden={n !== 0}>
            <figure class="htabs-photo">
              <Image src={g.image} alt={g.alt} widths={[640, 960, 1280]} sizes="(min-width: 768px) 44rem, 100vw" loading={n === 0 ? 'eager' : 'lazy'} />
              <figcaption class="htabs-card on-dark">
                <strong>{i.name.replace(/Wi-Fi/g, 'Wi‑Fi')}</strong>
                <ul>
                  {i.installs.slice(0, 3).map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </figcaption>
            </figure>
            <p class="htabs-line">
              {industryLines[i.slug]} <a class="text-link" href={`/business/${i.slug}/`}>See {i.name.replace(/Wi-Fi/g, 'Wi‑Fi')}</a>
            </p>
          </div>
        );
      })
    }
  </div>
</div>

<script>
  import { wireTabs } from '../scripts/tabs';
  document.querySelectorAll<HTMLElement>('[data-htabs]').forEach((root) => wireTabs(root, () => {}));
</script>
