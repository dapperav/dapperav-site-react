---
/** The dark close at the end of every page. */
import { site } from '../data/site';

interface Props {
  title?: string;
  lede?: string;
  href?: string;
  label?: string;
  secondary?: { href: string; label: string };
}
const {
  title = 'Book a free site survey',
  lede = '30–45 minutes on site, an itemized proposal after, and a reply within one business day. Or call or text me now.',
  href = `/quote/?service=${encodeURIComponent('Commercial AV')}`,
  label = 'Book a free site survey',
  secondary = { href: site.phoneHref, label: `Call ${site.phone}` },
} = Astro.props;
---

<section class="cta on-dark pinstripe" aria-labelledby="cta-title">
  <div class="hero-grooves hero-grooves--cta" aria-hidden="true"></div>
  <div class="container cta-inner">
    <h2 class="h2 cta-title" id="cta-title">{title}</h2>
    <p class="lede">{lede}</p>
    <div class="cta-actions">
      <a class="btn btn--primary btn--lg" href={href}>{label}</a>
      <a class="btn btn--ghost btn--lg" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>
