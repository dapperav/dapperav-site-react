---
import { site } from '../data/site';
import Record from './Record.astro';

interface Props {
  title?: string;
  body?: string;
  href?: string;
  cta?: string;
}

const {
  title = 'Ready to transform your space?',
  body = `Tell us about your project and we'll respond within one business day — or call or text ${site.phone} right now.`,
  href = '/quote/',
  cta = 'Request a Quote',
} = Astro.props;
---

<section class="pinstripe relative overflow-hidden bg-espresso">
  <Record class="max-lg:hidden right-[-15rem] top-1/2 w-[34rem] -translate-y-1/2" />
  <Record class="max-lg:hidden left-[-19rem] top-1/2 w-[30rem] -translate-y-1/2 opacity-70" />
  <div class="relative mx-auto max-w-6xl px-5 py-20 text-center sm:px-8 sm:py-24">
    <h2 class="font-display text-3xl font-semibold text-balance text-cream sm:text-4xl" data-reveal>
      {title}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-cream/70" data-reveal style="--rd: 80ms">
      {body}
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4" data-reveal style="--rd: 160ms">
      <a
        href={href}
        class="btn-sheen rounded-full bg-gold px-8 py-4 text-base font-semibold text-espresso transition-colors duration-300 hover:bg-gold-deep"
      >
        {cta}
      </a>
      <a
        href={site.phoneHref}
        class="glass-dark rounded-full px-8 py-4 text-base font-medium text-cream transition-colors duration-300 hover:text-gold"
      >
        Call {site.phone}
      </a>
    </div>
  </div>
</section>
