---
/** The close: the page's idea again on an inverted field, two lines at display size, one action. */
import { site } from '../data/site';

interface Props {
  line1?: string;
  line2?: string;
  support?: string;
  href?: string;
  cta?: string;
}

const {
  line1 = 'One number.',
  line2 = 'Every cable.',
  support,
  href = `/quote/?service=${encodeURIComponent('Commercial AV')}`,
  cta = 'Book a free site survey',
} = Astro.props;
---

<section class="chapter cta-field" data-field="#3b1005" data-ink="#f7f0e0">
  <h2 class="font-display cta-statement">
    <span>{line1}</span>
    <span class="text-gold">{line2}</span>
  </h2>
  <div class="cta-foot">
    <p class="cta-support">
      {
        support ?? (
          <>
            Call or text <a href={site.phoneHref}>{site.phone}</a>. The person who answers is the person who installs.
          </>
        )
      }
    </p>
    <a href={href} class="btn-flat btn-lg">
      {cta}
    </a>
  </div>
</section>
