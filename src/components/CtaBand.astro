---
/**
 * The dark close at the end of every page: a dark glass panel over a muted loop of patch cables in a switch
 * (Pexels clip 7140937, free license, no credit required; background footage, not a Dapper AV job).
 * Reduced motion: the loop never plays and the poster frame shows instead.
 */

interface Props {
  title?: string;
  lede?: string;
  href?: string;
  label?: string;
  secondary?: { href: string; label: string };
}
const {
  title = 'Book a free site survey',
  lede = '30–45 minutes on site, an itemized proposal after, and a reply within one business day.',
  href = `/quote/?service=${encodeURIComponent('Commercial AV')}`,
  label = 'Book a free site survey',
  secondary,
} = Astro.props;
---

<section class="cta on-dark" aria-labelledby="cta-title">
  <video class="cta-video" muted loop playsinline preload="none" poster="/video/cables-loop.jpg" aria-hidden="true" tabindex="-1">
    <source src="/video/cables-loop.webm" type="video/webm" />
    <source src="/video/cables-loop.mp4" type="video/mp4" />
  </video>
  <div class="container cta-inner">
    <div class="cta-panel">
      <h2 class="h2 cta-title" id="cta-title">{title}</h2>
      <p class="lede">{lede}</p>
      <div class="cta-actions">
        <a class="btn btn--primary btn--lg" href={href}>{label}</a>
        {secondary && <a class="btn btn--ghost btn--lg" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<script>
  // Play only while the band is on screen, and never when the visitor asked for less motion.
  const video = document.querySelector<HTMLVideoElement>('.cta-video');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { rootMargin: '200px' },
    ).observe(video);
  }
</script>
