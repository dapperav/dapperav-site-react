---
/**
 * Inner-page hero: a colour field with a two-line, two-ink statement (the homepage hero, one size down).
 * lines[0] in the field's ink, lines[1] in the accent ink. One supporting sentence, one primary action.
 */
interface Action {
  href: string;
  label: string;
}
interface Props {
  lines: [string, string?];
  support?: string;
  primary?: Action;
  secondary?: Action;
  field?: 'espresso' | 'parchment';
}

const { lines, support, primary, secondary, field = 'espresso' } = Astro.props;
const fields = {
  espresso: { bg: '#3b1005', ink: '#f7f0e0' },
  parchment: { bg: '#efe3cb', ink: '#3b1005' },
};
const f = fields[field];
---

<section class={`chapter hero-field hero-field--inner hero-field--${field}`} data-field={f.bg} data-ink={f.ink}>
  <h1 class="font-display hero-statement hero-statement--inner">
    <span class="hero-line">{lines[0]}</span>
    {lines[1] && <span class="hero-line hero-line--accent">{lines[1]}</span>}
  </h1>
  {
    (support || primary) && (
      <div class="hero-foot">
        {support && <p class="hero-support">{support}</p>}
        {(primary || secondary) && (
          <div class="hero-actions">
            {primary && (
              <a href={primary.href} class="btn-flat btn-lg">
                {primary.label}
              </a>
            )}
            {secondary && (
              <a href={secondary.href} class="link-plain">
                {secondary.label}
              </a>
            )}
          </div>
        )}
      </div>
    )
  }
</section>
