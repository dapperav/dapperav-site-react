---
/**
 * Plain bar: wordmark, three links, one action. No glass, no pill nav.
 * Its ground and ink follow the chapter under it ([data-field]/[data-ink] on sections; script in Layout).
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

const links = [
  { href: '/business/', label: 'For business' },
  { href: '/services/', label: 'For homes' },
  { href: '/work/', label: 'Our work' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---

<header id="site-header" class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-wordmark" aria-label="Dapper AV Solutions, home">
      <Image src={logo} alt="" width={80} height={80} class="h-10 w-10" loading="eager" />
      <span>Dapper AV</span>
    </a>
    <nav aria-label="Main" class="site-links">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="site-actions">
      <a href={site.phoneHref} class="site-call" aria-label={`Call ${site.phone}`}>
        <svg viewBox="0 0 24 24" class="site-call-icon" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
        </svg>
        <span class="site-call-text">Call</span>
      </a>
      <a href={`/quote/?service=${encodeURIComponent('Commercial AV')}`} class="btn-flat">
        <span class="site-btn-long">Book a site survey</span><span class="site-btn-short">Book a survey</span>
      </a>
    </div>
  </div>
</header>
