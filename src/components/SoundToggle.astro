---
/** Small "Sound off / Sound on" pill. Every toggle on the page shares one remembered setting (src/scripts/sound.ts). */
---

<button class="pill pill--sm sound-toggle" type="button" data-sound-toggle aria-pressed="false">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" /><path class="sound-waves" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
  <span data-sound-label>Sound off</span>
</button>

<script>
  import { initSoundToggles } from '../scripts/sound';
  initSoundToggles();
</script>
