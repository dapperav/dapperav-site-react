---
/** Questions as a typographic list: question at lead size, answer beneath. No cards, no rules. */
import { faqs as siteFaqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
  heading?: string;
  field?: 'cream' | 'parchment';
}

const { items: faqs = siteFaqs, heading = 'Straight answers.', field = 'cream' } = Astro.props;
const bg = field === 'cream' ? '#f7f0e0' : '#efe3cb';
---

<section class={`chapter text-espresso ${field === 'cream' ? 'bg-cream' : 'bg-parchment'}`} data-field={bg} data-ink="#3b1005">
  <div class="page-wrap section-pad faq">
    <h2 class="font-display h-section">{heading}</h2>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details class="faq-item" data-reveal>
            <summary>
              <span>{f.q}</span>
              <svg viewBox="0 0 24 24" class="faq-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
