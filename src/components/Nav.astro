---
/**
 * Desktop: the roundel. A centred logo disc that opens into a glass pill at the top of the page,
 * on hover and on keyboard focus, and folds back to the disc as you scroll; the survey button
 * then parks bottom-right. Mobile (2026-11-23): a slim glass bar at the top (logo = Home, survey
 * button once you scroll, Menu) that slides away while you scroll down and comes back when you
 * scroll up. A bottom dock stacked on Safari's own bottom toolbar and covered the hero.
 * Menu opens a bottom sheet (native <dialog>: focus trap, Esc, backdrop tap).
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { industries } from '../data/industries';
import { areas } from '../data/areas';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) =>
  (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''))) ? 'page' : undefined;
const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;
---

<header class="site-nav at-top" id="site-nav">
  <div class="nav-wrap">
    <nav class="nav-shell" aria-label="Main">
      <ul class="nav-group nav-group--left">
        <li><a class="nav-link" href="/business/" aria-current={current('/business/')}>Business</a></li>
        <li><a class="nav-link" href="/services/" aria-current={current('/services/')}>Homes</a></li>
      </ul>
      <a class="roundel" href="/" aria-label="Dapper AV Solutions, home" aria-current={current('/')}>
        <span class="roundel-spin"><Image class="roundel-img" src={logo} alt="" width={144} loading="eager" /></span>
      </a>
      <ul class="nav-group nav-group--right">
        <li><a class="nav-link" href="/business/#care-plans">Care plans</a></li>
        <li><a class="nav-link" href="/quote/" aria-current={current('/quote/')}>Contact</a></li>
      </ul>
    </nav>
    <a class="btn btn--primary btn--sm nav-cta" href={survey}>Book a free site survey</a>
  </div>
</header>

<a class="btn btn--primary float-cta" href={survey}>Book a free site survey</a>

<header class="mbar" id="mbar">
  <a class="mbar-home" href="/" aria-label="Dapper AV Solutions, home" aria-current={current('/')}>
    <span class="mbar-logo"><Image class="roundel-img" src={logo} alt="" width={96} loading="eager" /></span>
    <span class="mbar-name" aria-hidden="true">Dapper AV</span>
  </a>
  {path !== '/quote' && <a class="btn btn--primary btn--sm mbar-cta" href={survey}>Book a survey</a>}
  <button class="mbar-menu" type="button" id="menu-open" aria-haspopup="dialog" aria-controls="menu-sheet" aria-expanded="false">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h16M4 12h16M4 16.5h10"></path></svg>
    Menu
  </button>
</header>

<dialog class="menu-sheet" id="menu-sheet" aria-labelledby="menu-title">
  <div class="menu-inner">
    <div class="menu-grabber" aria-hidden="true"></div>
    <div class="menu-head">
      <p class="menu-title" id="menu-title"><Image src={logo} alt="" width={72} />Dapper AV</p>
      <button class="menu-close" type="button" data-close aria-label="Close menu">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <a class="btn btn--primary btn--lg menu-cta" href={survey}>Book a free site survey</a>
    <ul class="menu-links">
      {
        [
          ['/', 'Home'],
          ['/business/', 'For business'],
          ['/services/', 'For homes'],
          ['/quote/', 'Contact'],
        ].map(([href, label]) => (
          <li>
            <a href={href} data-astro-prefetch="load" aria-current={href === '/quote/' ? (path === '/quote' ? 'page' : undefined) : current(href)}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-group">
      <p class="label">Business pages</p>
      <ul class="chips">
        {industries.map((i) => <li><a class="pill" href={`/business/${i.slug}/`} aria-current={current(`/business/${i.slug}/`)}>{i.name}</a></li>)}
      </ul>
    </div>
    <div class="menu-group">
      <p class="label">Where we work</p>
      <ul class="chips">
        {areas.map((a) => <li><a class="pill" href={`/areas/${a.slug}/`} aria-current={current(`/areas/${a.slug}/`)}>{a.city}</a></li>)}
      </ul>
    </div>
  </div>
</dialog>

<script>
  // Mobile bar: hide while scrolling down, show on any scroll up (passive listener, one rAF per frame).
  const bar = document.getElementById('mbar');
  if (bar) {
    let lastY = scrollY, ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = scrollY, dy = y - lastY;
        if (Math.abs(dy) > 6) {
          bar.classList.toggle('is-away', dy > 0 && y > 120 && !document.querySelector('.menu-sheet[open]'));
          lastY = y;
        }
        ticking = false;
      });
    }, { passive: true });
    bar.addEventListener('focusin', () => bar.classList.remove('is-away'));
  }

  // Bottom sheet: native <dialog> gives the focus trap and Esc; this adds the slide and the
  // backdrop tap. Close animates out, then the dialog closes (exit path = entry path).
  const sheet = document.getElementById('menu-sheet') as HTMLDialogElement | null;
  const opener = document.getElementById('menu-open');
  if (sheet && opener && typeof sheet.showModal === 'function') {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    const open = () => {
      clearTimeout(timer);
      sheet.showModal();
      opener.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add('is-open')));
    };
    const close = () => {
      sheet.classList.remove('is-open');
      opener.setAttribute('aria-expanded', 'false');
      timer = window.setTimeout(() => sheet.close(), reduce.matches ? 200 : 320);
    };
    opener.addEventListener('click', open);
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    sheet.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === sheet || t.closest('[data-close]')) close(); // backdrop tap or close button
    });
    sheet.addEventListener('close', () => {
      sheet.classList.remove('is-open');
      opener.setAttribute('aria-expanded', 'false');
      opener.focus();
    });
  }
</script>
