---
/**
 * "One rack runs it all": a drawn rack with gold cables out to everything we install. Pick a kind of
 * business to light only the gear it uses. Hovering a device lights its cable; tapping it opens a card
 * with what we install there and what the survey checks, plus "Add to my survey". The picks build a
 * survey list, and the booking button hands it to the quote form as ?details= (like the TV planner).
 * Small pulses run along the lit cables while the map is on screen (never under reduced motion).
 * On phones the cables drop away: a small rack whose ports light up sits over a grid of the devices.
 */
import { industries } from '../data/industries';

type Kind = 'restaurant' | 'office' | 'shop';
type Device = { id: string; name: string; line: string; x: number; y: number; for: Kind[]; icon: string; does: string[]; check: string; page: string };

// every "does" line restates an install listed on the industry pages (src/data/industries.ts)
const devices: Device[] = [
  { id: 'tv', name: 'TV wall', line: 'Any screen shows any game, with one simple control for staff.', x: 140, y: 110, for: ['restaurant'],
    icon: 'M3 5h18v11H3zM8 20h8M12 16v4',
    does: ['Multi-TV walls with a video matrix: any source on any screen', 'One simple control for staff, no remote-control roulette', 'Outdoor-rated TVs for patios'],
    check: 'Where each screen goes, the viewing angles, and how the cable gets there.', page: 'restaurants-bars' },
  { id: 'menu', name: 'Menu screens', line: 'Screens, players and a connection that keeps them on.', x: 380, y: 70, for: ['restaurant', 'shop'],
    icon: 'M3 4h8v14H3zM13 4h8v14h-8zM5 8h4M5 11h4M15 8h4M15 11h4',
    does: ['Digital menu boards for counters and drive-thrus', 'Day-part scheduling: breakfast, lunch, dinner, happy hour', 'Screens that power on and off with your hours'],
    check: 'Screen spots, glare, and a solid connection for every player.', page: 'digital-signage' },
  { id: 'music', name: 'Zoned music', line: 'Background music by zone: bar, dining room, patio, restrooms.', x: 620, y: 70, for: ['restaurant', 'shop', 'office'],
    icon: 'M7 3h10v18H7zM12 15m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M12 7.5h.01',
    does: ['Zoned background music: bar, dining room, patio, restrooms', 'Zones for the floor, counter and offices in a shop', 'Outdoor-rated speakers for patios'],
    check: 'How many zones you need, and where the speakers and amplifier go.', page: 'restaurants-bars' },
  { id: 'wifi', name: 'Wi‑Fi', line: 'Guest Wi‑Fi that cannot reach business systems, planned for your floor.', x: 860, y: 110, for: ['restaurant', 'shop', 'office'],
    icon: 'M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h.01',
    does: ['UniFi access points placed and tuned for your floor plan', 'Guest Wi‑Fi that cannot reach business systems', 'Remote monitoring and updates under a care plan'],
    check: 'Your floor plan, the walls, and where the dead spots are today.', page: 'networks-wifi' },
  { id: 'cams', name: 'Cameras', line: 'Cameras you own, with health checks and footage export under a care plan.', x: 900, y: 330, for: ['restaurant', 'shop', 'office'],
    icon: 'M3 7h13l5-3v10l-5-3H3zM7 11v6M4 17h6',
    does: ['UniFi Protect cameras for the register, bar and back door', 'Local storage, so no per-camera cloud fees', 'Health checks and footage export under a care plan'],
    check: 'Every camera angle, and where the recorder will live.', page: 'networks-wifi' },
  { id: 'pos', name: 'Register network', line: 'The POS on its own secured network, apart from guest Wi‑Fi.', x: 850, y: 535, for: ['restaurant', 'shop'],
    icon: 'M4 10h16v10H4zM7 4h10v6H7zM8 14h2M12 14h2M8 17h8',
    does: ['POS, cameras and guest Wi‑Fi on separate, secured networks', 'Switches, gateway and firewall set up properly'],
    check: 'Where the registers sit and how they connect today.', page: 'networks-wifi' },
  { id: 'meeting', name: 'Meeting room', line: 'Displays and calls that start on the first try.', x: 150, y: 535, for: ['office'],
    icon: 'M3 4h18v10H3zM6 20l3-6M18 20l-3-6M9 18h6',
    does: ['Conference room displays and video bars for Teams and Zoom', 'Wireless screen sharing, no cable hunt', 'Ceiling microphones and speakers for larger rooms'],
    check: 'Room size, seating, and where the display and camera go.', page: 'offices-conference-rooms' },
  { id: 'desk', name: 'PCs & printers', line: 'Printers, PCs and Microsoft 365 users set up and looked after.', x: 100, y: 330, for: ['office'],
    icon: 'M3 4h18v12H3zM8 20h8M12 16v4',
    does: ['Microsoft 365 setup, users, licensing and email security', 'Office Wi‑Fi and structured cabling to every desk', 'Printers and PCs set up and looked after'],
    check: 'Each desk, the printers, and the network closet.', page: 'offices-conference-rooms' },
];
const filters: { id: 'all' | Kind; label: string }[] = [
  { id: 'all', label: 'Everything' },
  { id: 'restaurant', label: 'Restaurant or bar' },
  { id: 'office', label: 'Office' },
  { id: 'shop', label: 'Shop' },
];
const pageName = Object.fromEntries(industries.map((i) => [i.slug, i.name.replace(/Wi-Fi/g, 'Wi‑Fi')]));
const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;

// cables leave the rack from the nearest side and curve out to each device
const RACK = { x: 430, y: 220, w: 140, h: 220 };
const cable = (d: Device) => {
  const left = d.x < 500;
  const top = d.y < 160;
  const sx = top ? (left ? RACK.x + 40 : RACK.x + RACK.w - 40) : left ? RACK.x : RACK.x + RACK.w;
  const sy = top ? RACK.y : Math.min(Math.max(d.y, RACK.y + 30), RACK.y + RACK.h - 30);
  const c1 = top ? `${sx} ${sy - 80}` : `${(sx + d.x) / 2} ${sy}`;
  const c2 = top ? `${d.x} ${d.y + 90}` : `${(sx + d.x) / 2} ${d.y}`;
  return `M${sx} ${sy} C${c1} ${c2} ${d.x} ${d.y}`;
};
const units = [0, 1, 2, 3, 4, 5];
---

<section class="section" id="rack-map" aria-labelledby="rack-map-title">
  <div class="container">
    <div class="home-head">
      <h2 class="h2" id="rack-map-title">One rack runs it all</h2>
      <p class="lede">Everything we install comes back to one tidy rack. Pick your kind of business, tap anything to see what we do there, and add it to your survey list.</p>
    </div>
    <div class="rmap" data-rmap data-filter="all">
      <div class="pill-tabs" role="group" aria-label="Show the gear for">
        {filters.map((f, n) => <button class="pill" type="button" data-filter={f.id} aria-pressed={n === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      <div class="rmap-minirack" aria-hidden="true">
        {devices.map((d) => <i data-port={d.id}></i>)}
      </div>
      <div class="rmap-stage">
        <svg class="rmap-wires" viewBox="0 0 1000 600" aria-hidden="true">
          {
            devices.map((d) => (
              <g class="rmap-cable" data-for={d.id}>
                <path class="rmap-base" d={cable(d)} />
                <path class="rmap-lit" d={cable(d)} />
                <path class="rmap-pulse" d={cable(d)} pathLength="100" />
              </g>
            ))
          }
          <g class="rmap-rack">
            <rect x={RACK.x} y={RACK.y} width={RACK.w} height={RACK.h} rx="14" />
            {
              units.map((u) => (
                <g>
                  <rect class="rmap-unit" x={RACK.x + 14} y={RACK.y + 18 + u * 33} width={RACK.w - 28} height="26" rx="4" />
                  <circle class="rmap-led" cx={RACK.x + 28} cy={RACK.y + 31 + u * 33} r="3.5" style={`--d:${u * 0.37}s`} />
                  {[0, 1, 2, 3].map((p) => <rect class="rmap-port" x={RACK.x + 62 + p * 15} y={RACK.y + 25 + u * 33} width="10" height="12" rx="1.5" />)}
                </g>
              ))
            }
          </g>
        </svg>
        {
          devices.map((d) => (
            <button class="rmap-dev" type="button" data-dev={d.id} data-for={d.for.join(' ')} aria-controls={`rmap-info-${d.id}`} style={`--x:${d.x / 10}%;--y:${(d.y / 600) * 100}%`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={d.icon} /></svg>
              <span>{d.name}</span>
              <i class="rmap-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></i>
            </button>
          ))
        }
      </div>
      <div class="rmap-panel">
        <div class="rmap-detail" aria-live="polite">
          <p class="rmap-hint" data-hint><strong>Tap any device.</strong> See what we install there and what the survey checks, then add it to your list. Every cable ends in the same labeled rack, so one company looks after all of it.</p>
          {
            devices.map((d) => (
              <div class="rmap-info" id={`rmap-info-${d.id}`} data-info={d.id} hidden>
                <h3 class="rmap-info-title">{d.name}</h3>
                <ul class="rmap-does">{d.does.map((x) => <li>{x}</li>)}</ul>
                <p class="rmap-check"><strong>On the survey:</strong> {d.check}</p>
                <div class="rmap-actions">
                  <button class="pill pill--sm" type="button" data-pick={d.id} aria-pressed="false">Add to my survey</button>
                  <a class="text-link" href={`/business/${d.page}/`}>More on {pageName[d.page]}</a>
                </div>
              </div>
            ))
          }
        </div>
        <div class="rmap-list">
          <p class="rmap-list-title">Your survey list</p>
          <p class="rmap-list-empty" data-list-empty>Nothing yet. Add what you want looked at and it goes straight into your request.</p>
          <ul class="rmap-chips" data-chips></ul>
          <a class="btn btn--primary rmap-book" data-book href={survey}>Book a free site survey</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rmap]').forEach((root) => {
    const devs = [...root.querySelectorAll<HTMLButtonElement>('[data-dev]')];
    const pills = [...root.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const infos = [...root.querySelectorAll<HTMLElement>('[data-info]')];
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const chips = root.querySelector<HTMLElement>('[data-chips]')!;
    const empty = root.querySelector<HTMLElement>('[data-list-empty]')!;
    const book = root.querySelector<HTMLAnchorElement>('[data-book]')!;
    const cableOf = (id: string) => root.querySelector<SVGGElement>(`.rmap-cable[data-for="${id}"]`)!;
    const portOf = (id: string) => root.querySelector<HTMLElement>(`[data-port="${id}"]`)!;
    const nameOf = (id: string) => root.querySelector(`[data-dev="${id}"] span`)!.textContent!;
    const picked: string[] = [];
    let selected: HTMLButtonElement | null = null;

    function setFilter(f: string) {
      root.dataset.filter = f;
      pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.filter === f)));
      devs.forEach((d) => {
        const on = f === 'all' || d.dataset.for!.split(' ').includes(f);
        d.classList.toggle('is-dim', !on);
        cableOf(d.dataset.dev!).classList.toggle('is-dim', !on);
        portOf(d.dataset.dev!).classList.toggle('is-dim', !on);
      });
    }
    // hover only lights a cable; a tap (or Enter) opens the card, so the card never flickers under the mouse
    function highlight(d: HTMLButtonElement | null) {
      devs.forEach((x) => {
        x.classList.toggle('is-active', x === d);
        cableOf(x.dataset.dev!).classList.toggle('is-active', x === d);
      });
      root.classList.toggle('has-active', !!d);
    }
    function select(d: HTMLButtonElement) {
      selected = d;
      highlight(d);
      hint.hidden = true;
      infos.forEach((i) => (i.hidden = i.dataset.info !== d.dataset.dev));
      // phones: the card sits under the device grid, so bring it into view
      if (matchMedia('(max-width: 719px)').matches) {
        root.querySelector('.rmap-detail')!.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    }
    function render() {
      chips.replaceChildren(
        ...picked.map((id) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'pill pill--sm rmap-chip';
          b.textContent = nameOf(id);
          b.setAttribute('aria-label', `Remove ${nameOf(id)} from your survey list`);
          b.addEventListener('click', () => toggle(id));
          li.append(b);
          return li;
        })
      );
      empty.hidden = picked.length > 0;
      picks.forEach((b) => {
        const on = picked.includes(b.dataset.pick!);
        b.setAttribute('aria-pressed', String(on));
        b.textContent = on ? 'On your survey list' : 'Add to my survey';
      });
      devs.forEach((d) => {
        d.classList.toggle('is-picked', picked.includes(d.dataset.dev!));
        portOf(d.dataset.dev!).classList.toggle('is-picked', picked.includes(d.dataset.dev!));
      });
      const f = root.dataset.filter;
      const kind = f === 'all' ? '' : ` for a ${pills.find((p) => p.dataset.filter === f)!.textContent!.toLowerCase()}`;
      const details = picked.length ? `Survey list from the rack map${kind}: ${picked.map(nameOf).join(', ')}.` : '';
      book.href = `/quote/?service=${encodeURIComponent('Commercial AV')}${details ? `&details=${encodeURIComponent(details)}` : ''}`;
      book.textContent = picked.length ? `Book a survey for ${picked.length === 1 ? 'this' : `these ${picked.length}`}` : 'Book a free site survey';
    }
    function toggle(id: string) {
      const i = picked.indexOf(id);
      if (i >= 0) picked.splice(i, 1);
      else picked.push(id);
      render();
    }

    pills.forEach((p) => p.addEventListener('click', () => { setFilter(p.dataset.filter!); render(); }));
    devs.forEach((d) => {
      d.addEventListener('mouseenter', () => highlight(d));
      d.addEventListener('click', () => select(d));
    });
    root.querySelector('.rmap-stage')!.addEventListener('mouseleave', () => highlight(selected));
    picks.forEach((b) => b.addEventListener('click', () => toggle(b.dataset.pick!)));

    // pulses only run while the map is on screen
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => root.classList.toggle('is-live', e.isIntersecting), { threshold: 0.2 }).observe(root);
    }
  });
</script>
