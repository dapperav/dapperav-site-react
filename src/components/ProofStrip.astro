---
/**
 * At-a-glance facts: real facts only (CLAUDE.md + the synced Google rating).
 * Never add a number here that Mark hasn't confirmed.
 */
import reviews from '../data/reviews.json';
import { areas } from '../data/areas';

const { rating, total } = reviews as { rating?: number; total?: number };

const tracks = [
  // Written as '18 yrs', never '18+' — big '18+' reads as an age gate
  { n: '18 yrs', label: 'installing AV, and counting' },
  { n: '5 yrs', label: 'running managed IT' },
  ...(rating && total ? [{ n: rating.toFixed(1), label: `on Google, ${total} review${total === 1 ? '' : 's'}`, star: true }] : []),
  { n: String(areas.length), label: 'Fort Bend–area cities served' },
];
---

<section class="proof-strip bg-roast text-cream" aria-label="Dapper AV at a glance">
  <ol class="mx-auto grid max-w-6xl grid-cols-2 px-5 sm:px-8 lg:grid-cols-4">
    {
      tracks.map((t) => (
        <li class="proof-track">
          <span class="font-display proof-num">
            {t.n}
            {t.star && (
              <svg viewBox="0 0 24 24" class="proof-star" role="img" aria-label="stars">
                <path d="M12 2.8l2.7 6 6.5.6-4.9 4.3 1.5 6.4L12 16.8 6.2 20.1l1.5-6.4L2.8 9.4l6.5-.6z" fill="currentColor" />
              </svg>
            )}
          </span>
          <span class="proof-label">{t.label}</span>
        </li>
      ))
    }
  </ol>
</section>
