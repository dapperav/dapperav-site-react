---
/** Tidy rack vs messy closet. Both are other people's racks (found, credited) and say so. */
import { Image } from 'astro:assets';
import rack from '../assets/found/rear-of-rack-at-nersc-data-center.jpg';
import closet from '../assets/found/cable-closet.jpg';

interface Props {
  heading?: string;
}
const { heading = 'Most closets look like the one on the right.' } = Astro.props;
---

<section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
  <div class="page-wrap section-pad">
    <h2 class="font-display h-section">{heading}</h2>
    <div class="closet-pair">
      <figure data-reveal>
        <Image
          src={rack}
          alt="A tidy server rack with cables bundled, labeled and routed down the side"
          widths={[600, 900, 1200]}
          sizes="(min-width: 768px) 45vw, 100vw"
          class="closet-img"
        />
        <figcaption>Bundled, labeled and documented. This is what yours should look like.</figcaption>
      </figure>
      <figure data-reveal>
        <Image
          src={closet}
          alt="A cable closet with tangled yellow, red and blue network cables"
          widths={[600, 900, 1200]}
          sizes="(min-width: 768px) 45vw, 100vw"
          class="closet-img"
        />
        <figcaption>The usual closet. When something breaks, nobody can tell which cable it is.</figcaption>
      </figure>
    </div>
    <p class="closet-note">Both photos are other people's racks, credited at the bottom of the page. Neither is my job.</p>
  </div>
</section>
