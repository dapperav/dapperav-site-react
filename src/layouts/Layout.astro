---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, services, GA4_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Additional JSON-LD blocks (FAQPage, Service, etc.) injected by pages */
  extraSchema?: object[];
}

const { title, description, extraSchema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  telephone: '+19728241303',
  email: site.email,
  image: `${site.url}/og-image.png`,
  logo: `${site.url}/icon-512.png`,
  description:
    'Commercial AV and managed IT company in Richmond, TX, serving Fort Bend County: TV walls, business Wi-Fi and networks, cameras, structured cabling, digital signage and Microsoft 365. Residential TV mounting and home theater too.',
  priceRange: '$$',
  // Service-area business: city only, no street (matches the Google Business Profile)
  address: { '@type': 'PostalAddress', addressLocality: 'Richmond', addressRegion: 'TX', addressCountry: 'US' },
  hasMap: 'https://www.google.com/maps/place/?q=place_id:ChIJu1Q7sb3Sk6gRbGDmkUJWSq4',
  areaServed: [
    { '@type': 'City', name: 'Richmond, TX' },
    { '@type': 'City', name: 'Rosenberg, TX' },
    { '@type': 'City', name: 'Fulshear, TX' },
    { '@type': 'City', name: 'Sugar Land, TX' },
    { '@type': 'City', name: 'Stafford, TX' },
    { '@type': 'City', name: 'Katy, TX' },
    { '@type': 'AdministrativeArea', name: 'Fort Bend County, TX' },
  ],
  geo: { '@type': 'GeoCoordinates', latitude: 29.5822, longitude: -95.7608 },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '17:00',
  },
  founder: { '@type': 'Person', name: 'Mark Immler' },
  sameAs: site.socials.map((s) => s.url),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AV & IT Services',
    itemListElement: [...services].sort((a, b) => Number(b.category !== 'residential') - Number(a.category !== 'residential')).map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.blurb },
      ...(s.price
        ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: Number(s.price.replace(/[^0-9]/g, '')), priceCurrency: 'USD' } }
        : {}),
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Arriving through a view transition, the header is carried over: skip the disc's load spin.
      addEventListener('pagereveal', (e) => e.viewTransition && document.documentElement.classList.add('vt-arrived'));
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#531b0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dapper AV Solutions — Professional. Precise. Personal." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraSchema.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    {
      GA4_MEASUREMENT_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
          <script
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA4_MEASUREMENT_ID}');`}
          />
          <script is:inline>
            // Count call / text / email taps as GA4 events (mark them as key events in GA4 Admin).
            document.addEventListener('click', (e) => {
              const a = e.target.closest?.('a[href^="tel:"], a[href^="sms:"], a[href^="mailto:"]');
              if (!a || typeof gtag !== 'function') return;
              const kind = a.protocol === 'tel:' ? 'phone_click' : a.protocol === 'sms:' ? 'text_click' : 'email_click';
              gtag('event', kind, { link_text: a.textContent.trim().slice(0, 60), page_path: location.pathname });
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <span class="page-sentinel" aria-hidden="true"></span>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // 1. Roundel nav: open at the top of the page, fold to the disc once you scroll.
      //    An observer on a 1px sentinel instead of a scroll listener.
      const nav = document.getElementById('site-nav');
      const sentinel = document.querySelector('.page-sentinel');
      if (nav && sentinel && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          const atTop = entry.isIntersecting || entry.boundingClientRect.top > 0;
          nav.classList.toggle('at-top', atTop);
          document.body.classList.toggle('is-scrolled', !atTop);
        }).observe(sentinel);
      }

      // 2. Reveals: once only, then forgotten. Content is visible without JS (see .js gate in CSS).
      //    Section openers stagger their parts (heading, then text, then the rest) 80ms apart.
      //    Anything already on screen at load is left alone so nothing blinks out and back.
      for (const group of document.querySelectorAll('.section-head, .faq-head, .owner-copy, .facts--big, .biz-list, .cta-inner')) {
        [...group.children].forEach((el, i) => {
          if (el.hasAttribute('data-reveal') || el.getBoundingClientRect().top < innerHeight) return;
          el.setAttribute('data-reveal', '');
          el.style.setProperty('--d', `${Math.min(i, 6) * 80}ms`);
        });
      }
      const revealed = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
