---
/** Privacy policy in plain words: what the site collects (the request form, Google Analytics) and why. Calm card layout. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import '../styles/home.css';
const updated = 'November 19, 2026';
---

<Layout
  title="Privacy Policy | Dapper AV"
  description="How Dapper AV Solutions handles the details you send through the request form and what the site measures."
>
  <div class="home-page">
    <Hero center lead="Privacy policy" main="What we collect, and why." lede={`Last updated ${updated}.`} />

    <section class="section" aria-labelledby="privacy-short">
      <div class="container privacy">
        <div class="home-checks on-dark">
          <div>
            <h2 class="h3" id="privacy-short">The short version</h2>
            <p>The details are below. Nothing here changes without a new date at the top.</p>
          </div>
          <ul class="checklist">
            <li>Your details are used only to answer your request.</li>
            <li>We never sell them or share them with marketers.</li>
            <li>Analytics counts visits and never records your name or contact details.</li>
            <li>Ask, and we delete your request.</li>
          </ul>
        </div>

        <div class="privacy-card">
          <article>
            <h2 class="h3">What you send us</h2>
            <p>
              When you use the request form we receive what you type into it: your name, a phone number or email, an optional
              business name, the service you picked, and any details you add. The form is delivered to our inbox by Web3Forms,
              a form-delivery service. We use these details only to answer your request, schedule a site survey and send your
              quote.
            </p>
          </article>
          <article>
            <h2 class="h3">What we don't do</h2>
            <p>
              We don't sell your details, share them with marketers or add you to a newsletter. We don't send marketing email
              unless you ask for it.
            </p>
          </article>
          <article>
            <h2 class="h3">What the site measures</h2>
            <p>
              The site uses Google Analytics to count visits and see which pages are useful, and it records when a request is
              sent (without your name or contact details). Google Analytics sets cookies in your browser for this. You can
              block or delete them in your browser settings, and the site works the same without them.
            </p>
          </article>
          <article>
            <h2 class="h3">How long we keep it</h2>
            <p>
              Requests stay in our email for as long as they're useful for the job, its warranty and its support. If you'd
              like yours deleted, email <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a> and we will.
            </p>
          </article>
          <article>
            <h2 class="h3">Questions</h2>
            <div>
              <p>Dapper AV Solutions is based in Richmond, Texas. Email us and the owner answers.</p>
              <a class="btn btn--ghost privacy-mail" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .privacy {
    max-width: 60rem;
  }
  .privacy .home-checks {
    margin-top: 0;
  }
  /* one card, one row per topic: heading left, text right */
  .privacy-card {
    margin-top: var(--space-5);
    padding: 0 clamp(var(--space-5), 3vw, var(--space-7));
    border-radius: var(--radius-card);
    background: var(--color-bg-alt);
  }
  .privacy-card article {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }
  .privacy-card article + article {
    border-top: 1px solid var(--hairline-light);
  }
  .privacy-card p {
    max-width: 38rem;
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    .privacy-card article {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-6);
    }
  }
  .privacy-mail {
    margin-top: var(--space-4);
  }
</style>
