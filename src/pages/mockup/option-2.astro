---
/** MOCKUP, not live: homepage Option 2 "Two doors". Branch mockup/homepage-options. */
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import MockSections from '../../components/MockSections.astro';
import { services } from '../../data/site';
import '../../styles/mockups.css';

const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;
const homeQuote = `/quote/?service=${encodeURIComponent('TV Mounting & Installation')}`;
const home = ['tv-mounting', 'home-theater', 'whole-home-audio'].map((id) => services.find((s) => s.id === id)!);
const shortName: Record<string, string> = { 'tv-mounting': 'TV mounting', 'home-theater': 'Home theater', 'whole-home-audio': 'Whole-home audio' };
---

<Layout title="Mockup: Option 2, two doors | Dapper AV" description="Homepage layout mockup (not live).">
  <div class="mk-page">
    <section class="hero on-dark pinstripe mk-hero2" id="top" aria-labelledby="top-title">
      <div class="container">
        <h1 class="hero-title" id="top-title">
          <span class="hero-title-lead">One local contact for</span>
          <span class="hero-title-main">
            everything with a
            <span class="cable-anchor">cable.<svg class="cable-line" viewBox="0 0 200 20" aria-hidden="true"><path d="M3 11 C 40 4, 72 17, 110 10 S 168 6, 184 10"></path><circle cx="190" cy="10" r="5"></circle></svg></span>
          </span>
        </h1>
        <p class="hero-lede">Fort Bend County’s AV, Wi-Fi, cameras, cabling and managed IT. Pick your door.</p>

        <div class="mk-doors">
          <div class="mk-door mk-glass-dark on-dark">
            <h2 class="mk-door-title">For your business</h2>
            <p>Restaurants, offices, retail, signage, business Wi-Fi and cabling. Installed around your hours, then looked after.</p>
            <ul class="mk-door-list">
              <li><strong>Free site survey</strong><span>30–45 min</span></li>
              <li><strong>Itemized price before any work</strong><span>In writing</span></li>
              <li><strong>A reply within one business day</strong><span>Every time</span></li>
            </ul>
            <div class="mk-door-actions">
              <a class="btn btn--primary btn--lg" href={survey}>Book a free site survey <span class="btn-orb" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a>
              <a class="text-link" href="/business/">See business services</a>
            </div>
          </div>
          <div class="mk-door mk-glass-light">
            <h2 class="mk-door-title">For your home</h2>
            <p>TVs mounted level with the wires hidden, home theaters and music in every room.</p>
            <ul class="mk-door-list">
              {home.map((s) => <li><strong>{shortName[s.id]}</strong><span>{s.price}</span></li>)}
            </ul>
            <div class="mk-door-actions">
              <a class="btn btn--ghost btn--lg" href={homeQuote}>Get a free quote</a>
              <a class="text-link" href="/services/">See home services</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <MockSections />
    <CtaBand href={survey} />
  </div>
</Layout>
