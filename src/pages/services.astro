---
/** Homes: a real install in the hero, honest starting prices, three bundles, the hi-fi sleeve, FAQs. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sleeve from '../components/Sleeve.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services, faqs, homeServiceLabels } from '../data/site';
import { gallery } from '../data/gallery';

const residential = services.filter((s) => s.category === 'residential');
const homeQuote = (s: string) => `/quote/?service=${encodeURIComponent(s)}`;
// map each home service to the quote form option it pre-selects
const quoteFor: Record<string, string> = {
  'tv-mounting': 'TV Mounting & Installation',
  'home-theater': 'Home Theater',
  'whole-home-audio': 'Whole Home Audio',
  'smart-home': 'Smart Home Automation',
  networks: 'Network & Wi-Fi',
};
const label = homeServiceLabels;
const fireplace = gallery.find((g) => g.title.startsWith('Over-mantel')) ?? gallery[0];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const packages = [
  { name: 'Basic TV mount', price: 'From $150', features: ['Single TV wall mount, up to 65"', 'Basic cable management', 'Level and secure install', 'Tested before I leave'] },
  { name: 'Premium TV package', price: 'From $250', features: ['Any size TV', 'Cables hidden inside the wall', 'Soundbar mounted and set up', 'Universal remote programmed', 'Outlet relocated if needed'] },
  { name: 'Smart home bundle', service: 'Smart Home Automation', price: 'From $500', features: ['The premium TV package', 'Smart home hub set up', 'Voice control', 'Smart lighting, three switches', 'Streaming devices tuned'] },
];
---

<Layout
  title="TV Mounting, Home Theater & Smart Home | Dapper AV"
  description="TV mounting from $150, home theaters, whole-home audio and smart home installs in Richmond, Katy, Sugar Land and Fort Bend County. Free consultations."
  extraSchema={[faqSchema]}
>
  <Hero
    tone="light"
    lead="TV mounting, theaters and audio at home"
    main="Your TV, mounted like it belongs."
    lede="Level, centered and with every wire inside the wall. Honest starting prices, and an itemized quote before any work begins."
    actions={[
      { href: homeQuote('TV Mounting & Installation'), label: 'Get a free quote', arrow: true },
      { href: '/work/', label: 'See real installs', variant: 'ghost' },
    ]}
  >
    <p class="hero-aside">For most TV mounts, the TV size and the wall type are all I need to quote it.</p>
    <ul slot="aside" class="sleeves sleeves--hero">
      <Sleeve item={fireplace} title="Over-mantel TV and soundbar" caption="Dead center over the fireplace, soundbar aligned under it, every wire inside the wall." eager sizes="(min-width: 1024px) 28vw, 80vw" />
    </ul>
  </Hero>

  <section class="section section--alt" id="home-services" aria-labelledby="svc-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="svc-title">What I do at home</h2>
        <p class="lede">Starting prices are real starting prices. The survey or a photo turns them into an exact, itemized number.</p>
      </div>
      <div class="svc-list">
        {
          residential.map((s) => (
            <article class="svc" id={s.id} data-reveal>
              <div class="svc-head">
                <h3 class="svc-title">{label[s.id] ?? s.title}</h3>
                <p class="svc-price">{s.price}</p>
              </div>
              <div class="svc-body">
                <p>{s.blurb}</p>
                <ul class="checklist checklist--light svc-features" aria-label={`${label[s.id] ?? s.title} includes`}>
                  {s.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class="text-link" href={homeQuote(quoteFor[s.id] ?? s.title)}>
                  Get a quote<span class="visually-hidden"> for {(label[s.id] ?? s.title).toLowerCase()}</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section on-dark pinstripe" id="bundles" aria-labelledby="bundles-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="bundles-title">Straight bundles, straight prices</h2>
        <p class="lede">Three common jobs, priced from the start. Brick, stone or tile walls and longer cable runs add to the price, and you'll see that before I start.</p>
      </div>
      <div class="bezel bezel--dark plan-panel" data-reveal>
        <div class="bezel-core">
          {
            packages.map((p) => (
              <div class="plan">
                <h3 class="plan-name">{p.name}</h3>
                <p class="plan-price">{p.price}</p>
                <ul class="checklist">
                  {p.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class="btn btn--ghost btn--sm" href={homeQuote(p.service ?? 'TV Mounting & Installation')}>
                  Start with this one<span class="visually-hidden">: {p.name}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="Homeowner questions" lede="Prices, wires, trip fees and where I go." alt />

  <section class="section section--tight" aria-label="For businesses">
    <div class="container">
      <div class="frost callout">
        <div class="callout-copy">
          <h2 class="h3">Running a business?</h2>
          <p>Commercial AV, business Wi-Fi, cameras and managed IT are the main part of what I do.</p>
        </div>
        <a class="btn btn--secondary" href="/business/">Business services</a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Get a free quote"
    lede="Tell me the TV size and the wall. For most mounts that is all I need, or book a free consultation and I'll come look."
    href={homeQuote('TV Mounting & Installation')}
    label="Get a free quote"
  />
</Layout>
