---
/** Homes in the calm, one-column card layout (2026-11-20): services with real starting prices, bundles, FAQs. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, faqs, homeServiceLabels } from '../data/site';
import '../styles/home.css';

const residential = services.filter((s) => s.category === 'residential');
const homeQuote = (s: string) => `/quote/?service=${encodeURIComponent(s)}`;
const quoteFor: Record<string, string> = {
  'tv-mounting': 'TV Mounting & Installation',
  'home-theater': 'Home Theater',
  'whole-home-audio': 'Whole Home Audio',
  'smart-home': 'Smart Home Automation',
  networks: 'Network & Wi-Fi',
};
const label = homeServiceLabels;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const packages = [
  { name: 'Basic TV mount', price: 'From $150', features: ['Single TV wall mount, up to 65"', 'Basic cable management', 'Level and secure install', 'Tested before we leave'] },
  { name: 'Premium TV package', price: 'From $250', features: ['Any size TV', 'Cables hidden inside the wall', 'Soundbar mounted and set up', 'Universal remote programmed', 'Outlet relocated if needed'] },
  { name: 'Smart home bundle', service: 'Smart Home Automation', price: 'From $500', features: ['The premium TV package', 'Smart home hub set up', 'Voice control', 'Smart lighting, three switches', 'Streaming devices tuned'] },
];
---

<Layout
  title="TV Mounting, Home Theater & Smart Home | Dapper AV"
  description="TV mounting from $150, home theaters, whole-home audio and smart home installs in Richmond, Katy, Sugar Land and Fort Bend County. Free consultations."
  extraSchema={[faqSchema]}
>
  <div class="home-page">
    <Hero
      tone="light"
      center={true}
      lead="TV mounting, theaters and audio at home"
      main="Your TV, mounted like it belongs."
      lede="Level, centered and with every wire inside the wall. Honest starting prices, and an itemized quote before any work begins."
      actions={[{ href: homeQuote('TV Mounting & Installation'), label: 'Get a free quote' }]}
    >
      <p class="hero-aside">For most TV mounts, the TV size and the wall type are all we need to quote it.</p>
    </Hero>

    <section class="section section--alt" id="home-services" aria-labelledby="svc-title">
      <div class="container">
        <div class="home-head">
          <h2 class="h2" id="svc-title">What we do at home</h2>
          <p class="lede">Starting prices are real starting prices. A few details on the form turn them into an exact, itemized number.</p>
        </div>
        <div class="home-svc">
          {
            residential.map((s) => (
              <article class="home-svc-card" id={s.id}>
                <div class="home-svc-head">
                  <h3>{label[s.id] ?? s.title}</h3>
                  <p class="home-svc-price">{s.price}</p>
                </div>
                <p>{s.blurb}</p>
                <ul class="checklist checklist--light" aria-label={`${label[s.id] ?? s.title} includes`}>
                  {s.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class="text-link" href={homeQuote(quoteFor[s.id] ?? s.title)}>
                  Get a free quote<span class="visually-hidden"> for {(label[s.id] ?? s.title).toLowerCase()}</span>
                </a>
              </article>
            ))
          }
          <article class="home-svc-card home-svc-card--dark on-dark">
            <h3>Not on the list?</h3>
            <p>Outdoor TVs, projectors, moving a system to a new house: tell us what you have in mind on the form and we'll quote it.</p>
            <a class="btn btn--ghost" href={homeQuote('TV Mounting & Installation')}>Get a free quote</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="bundles" aria-labelledby="bundles-title">
      <div class="container">
        <div class="home-head">
          <h2 class="h2" id="bundles-title">Straight bundles, straight prices</h2>
          <p class="lede">Three common jobs, priced from the start. Brick, stone or tile walls and longer cable runs add to the price, and you'll see that before we start.</p>
        </div>
        <div class="home-plans">
          {
            packages.map((p) => (
              <div class="home-plan home-plan--light">
                <h3>{p.name}</h3>
                <p class="home-plan-price">{p.price}</p>
                <ul class="checklist checklist--light">
                  {p.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <a class="btn btn--ghost" href={homeQuote(p.service ?? 'TV Mounting & Installation')}>
                  Get a free quote<span class="visually-hidden">: {p.name}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Faq items={faqs} heading="Homeowner questions" lede="Prices, wires, trip fees and where we go." alt />

    <section class="section" aria-labelledby="biz-title">
      <div class="container">
        <div class="home-door home-door--biz home-door-solo on-dark">
          <h2 class="home-door-title" id="biz-title">Running a business?</h2>
          <p>Commercial AV, business Wi-Fi, cameras and managed IT are the main part of what we do.</p>
          <div class="home-door-actions">
            <a class="btn btn--ghost" href="/business/">See business services</a>
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      title="Get a free quote"
      lede="Tell us the TV size and the wall. For most mounts that is all we need, or book a free consultation and we'll come look."
      href={homeQuote('TV Mounting & Installation')}
      label="Get a free quote"
    />
  </div>
</Layout>
