---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import IndustryCards from '../components/IndustryCards.astro';
import PatchPanel from '../components/PatchPanel.astro';
import '../styles/home.css';
---

<Layout title="Page not found | Dapper AV" description="That page doesn't exist. Head back to Dapper AV Solutions.">
  <div class="home-page">
    <Hero
      tag="Unplugged · 404"
      center
      page={false}
      lead="Wrong cable."
      main="Page not found."
      lede="The page you wanted has moved or never existed. Head home, book a survey or pick your kind of business below."
      actions={[
        { href: `/quote/?service=${encodeURIComponent('Commercial AV')}`, label: 'Book a free site survey' },
        { href: '/', label: 'Back to home', variant: 'ghost' },
      ]}
    >
      <p class="hero-aside">At home? <a class="text-link" href="/services/">See home services</a>.</p>
    </Hero>

    <PatchPanel />

    <IndustryCards heading="Popular pages" lede="Six kinds of business, each with what we install there and what moves the price." alt={false} />
  </div>
</Layout>
