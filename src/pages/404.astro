---
import Layout from '../layouts/Layout.astro';
import ClosetPair from '../components/ClosetPair.astro';
import PictureBand from '../components/PictureBand.astro';
import PageHero from '../components/PageHero.astro';
import FortBendPair from '../components/FortBendPair.astro';
import { site } from '../data/site';
---

<Layout title="Page not found | Dapper AV" description="That page doesn't exist. Head back to Dapper AV Solutions.">
  <PageHero
    lines={['Wrong cable.', 'Page not found.']}
    support={`The page you wanted has moved or never existed. Head home, or call or text ${site.phone}.`}
    primary={{ href: '/', label: 'Back to home' }}
    secondary={{ href: '/quote/', label: 'Book a free site survey' }}
  />

  <ClosetPair heading="This is what a wrong turn looks like." />

  <PictureBand />

  <section class="chapter bg-parchment text-espresso" data-field="#efe3cb" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">Still in Fort Bend.</h2>
      <p class="intro-lead mt-6">You're on the right site, just the wrong page. <a href="/" class="link-plain">Start from home</a>.</p>
      <FortBendPair />
    </div>
  </section>
</Layout>
