---
/** City pages — business first, same system as the homepage (taste-skill, "Type and nothing else"). */
import Layout from '../../layouts/Layout.astro';
import OwnerPanel from '../../components/OwnerPanel.astro';
import PictureBand from '../../components/PictureBand.astro';
import FortBendPair from '../../components/FortBendPair.astro';
import PageHero from '../../components/PageHero.astro';
import BigList from '../../components/BigList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas } from '../../data/areas';
import { industries } from '../../data/industries';
import { site, services } from '../../data/site';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const residential = services.filter((s) => s.category === 'residential');
const surveyHref = `/quote/?service=${encodeURIComponent('Commercial AV')}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: area.headline,
  serviceType: 'Commercial audio visual and IT installation',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'City', name: `${area.city}, TX` },
  description: area.blurb,
};
---

<Layout
  title={`Commercial AV & Business IT in ${area.city}, TX | Dapper AV`}
  description={`Commercial AV, business networks and cameras for ${area.city}, TX businesses, plus TV mounting and home theater. Free site surveys. Call ${site.phone}.`}
  extraSchema={[serviceSchema]}
>
  <PageHero
    lines={['AV and IT', `in ${area.city}.`]}
    support={`TV walls, sound, Wi-Fi and cameras for ${area.city} businesses, installed and looked after by one local person.`}
    primary={{ href: surveyHref, label: 'Book a free site survey' }}
    secondary={{ href: site.phoneHref, label: `Call ${site.phone}` }}
  />

  <section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <p class="intro-lead">{area.blurb}</p>
      <FortBendPair />
    </div>
  </section>

  <BigList
    heading={`Businesses in ${area.city}`}
    items={industries.map((i) => ({ title: i.name, desc: i.installs.slice(0, 2).join('. ') + '.', href: `/business/${i.slug}/` }))}
  />

  <section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">Homes in {area.city}, too.</h2>
      <p class="intro-lead mt-8">{area.homeBlurb}</p>
      <p class="mt-6 text-[1.125rem] leading-relaxed">
        Neighborhoods I'm regularly in: <strong>{area.neighborhoods.join(', ')}</strong>, and everywhere in between.
      </p>
      <ul class="link-row">
        {
          residential.map((s) => (
            <li>
              <a href={`/services/#${s.id}`} class="pill-link">
                {s.title}, {s.price.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <PictureBand />

  <OwnerPanel />

  <CtaBand line1="Let's look at" line2="your space." href={surveyHref} />
</Layout>
