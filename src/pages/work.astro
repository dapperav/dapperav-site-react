---
/** Our work: only real Dapper AV installs as record sleeves, then the gear (credited, labeled as gear). */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sleeve from '../components/Sleeve.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery } from '../data/gallery';

const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;
---

<Layout
  title="Our Work: Real Installs in Fort Bend County | Dapper AV"
  description="Real Dapper AV installs across Fort Bend County, photographed on the job, plus the gear I install for businesses and homes."
>
  <Hero
    lead="Real installs, photographed on the job"
    main="Rooms I've dressed up."
    lede="Every photo here is a Dapper AV job in a Fort Bend County home."
    actions={[{ href: survey, label: 'Book a free site survey', arrow: true }]}
  />

  <section class="section grooves" id="installs" aria-labelledby="installs-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="installs-title">Recent installs</h2>
        <p class="lede">Clean lines, level mounts and no visible wire.</p>
      </div>
      <ul class="sleeves sleeves--big">
        {gallery.map((item, i) => <Sleeve item={item} delay={i * 90} sizes="(min-width: 1024px) 40vw, 90vw" />)}
      </ul>
      <p class="work-note">
        Every one of these is mine. New installs go up as jobs finish. Want to see something like your space? Ask during the survey.
      </p>
    </div>
  </section>

  <Reviews />

  <CtaBand title="Your space could be next" lede="Tell me what you have in mind and I'll show you similar work during the free survey. A reply within one business day." href={survey} />
</Layout>
