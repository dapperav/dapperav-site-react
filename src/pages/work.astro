---
/** Our work — real installs only, each given room (oversized visual, small cluster). */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PictureBand from '../components/PictureBand.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery } from '../data/gallery';
---

<Layout
  title="Our Work: Real Installs in Fort Bend County | Dapper AV"
  description="Real Dapper AV installs across Fort Bend County: TV mounts, hi-fi systems and commercial displays. Every photo is our own work."
>
  <PageHero
    field="parchment"
    lines={['Real installs,', 'real rooms.']}
    support="Every photo on this page is a Dapper AV job. More go up as jobs finish."
  />

  <section class="chapter bg-cream text-espresso work" data-field="#f7f0e0" data-ink="#3b1005">
    <h2 class="sr-only">Installs</h2>
    {
      gallery.map((item, i) => (
        <article class={`work-block ${i % 2 ? 'work-block--second' : ''}`}>
          <div class={`work-visual ${i === 0 ? 'work-visual--tall' : ''}`}>
            <Image
              src={item.image}
              alt={item.alt}
              widths={[700, 1100, 1500]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="work-img"
              style={item.pos ? `object-position: ${item.pos}` : undefined}
            />
          </div>
          <div class="work-cluster" data-reveal>
            <h3 class="font-display work-title">{item.title}</h3>
            <p class="work-desc">
              {item.caption} {item.category === 'commercial' ? 'A commercial job.' : 'A Fort Bend County home.'}
            </p>
          </div>
        </article>
      ))
    }
  </section>

  <PictureBand />

  <CtaBand line1="Your space" line2="could be next." support="Tell me what you have in mind and I'll show you similar work during the free survey." />
</Layout>
