---
/**
 * Homepage, concept 01 "Original, remastered": Mark's original look (roundel nav, pinstripe,
 * on the logo-verified tokens, taste rules applied. Commercial first, homes second.
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Owner from '../components/Owner.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { industries } from '../data/industries';
import { gear, industryThumb } from '../data/gear';


const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;
const lines: Record<string, string> = {
  'restaurants-bars': 'TV walls, zoned music and a POS network kept apart from guest Wi-Fi.',
  'offices-conference-rooms': 'Meeting rooms that start on the first try, and the Microsoft 365 behind them.',
  'retail-showrooms': 'Flush-mounted displays, background music and cameras you own.',
  'digital-signage': 'Screens, players and a connection that keeps them on.',
  'networks-wifi': 'UniFi networks planned like an IT department would: segmented and documented.',
  'structured-cabling': 'One sub for data, Wi-Fi, cameras, TVs and speakers. Labeled at closeout.',
};
---

<Layout
  title="Commercial AV & Managed IT, Richmond TX | Dapper AV"
  description="Commercial AV, business Wi-Fi, cameras and managed IT for Fort Bend County businesses, plus TV mounting and home theater. Free site surveys."
>
  <Hero
    page={false}
    lead="One local contact for"
    main="everything with a cable."
    lede="Restaurants, offices, retail and signage in Richmond, Sugar Land, Katy and across Fort Bend County. AV, Wi-Fi, cameras, cabling and managed IT from one company that also runs IT."
    actions={[
      { href: survey, label: 'Book a free site survey', arrow: true },
      { href: '/business/', label: 'Business services', variant: 'ghost' },
    ]}
  >
    <p class="hero-aside">
      Homeowner? <a class="text-link" href="/services/">See home services</a>.
    </p>
    <aside slot="aside" class="bezel bezel--dark hero-card" aria-labelledby="survey-card-title">
      <div class="bezel-core">
        <h2 class="hero-card-title" id="survey-card-title">What the free survey is</h2>
        <ul class="hero-card-list">
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
            <span><strong>30–45 minutes at your place.</strong> We walk the space and write down every screen, cable drop and camera spot.</span>
          </li>
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5z"></path><path d="M8.5 9h7M8.5 12.5h7M8.5 16h4"></path></svg>
            <span><strong>A written, itemized price.</strong> Nothing is installed until you approve it.</span>
          </li>
          <li>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5h15v9h-9l-4 3v-3h-2z"></path></svg>
            <span><strong>A reply within one business day.</strong> Every request is read and answered, never auto-filed.</span>
          </li>
        </ul>
      </div>
    </aside>
  </Hero>

  <section class="section section--alt grooves" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="services-title">Businesses first. Homes too.</h2>
        <p class="lede">One standard of workmanship, from a single conference room to a whole building. Business work is custom-quoted after a free site survey.</p>
      </div>

      <div class="biz on-dark pinstripe">
        <div class="biz-intro">
          <h3 class="h3">For your business</h3>
          <p>An IT department for businesses that don't have one. UniFi networks and cameras, Microsoft 365, and the screens and sound on top, installed and then looked after by the same company.</p>
          <ul class="checklist biz-promises">
            <li>Installed before open, after close or on weekends, so you never close for it.</li>
            <li>The person who installs it is the person who looks after it afterward.</li>
            <li>An itemized price after a free survey, in writing, before any work starts.</li>
          </ul>
          <a class="btn btn--primary" href="/business/">All business services</a>
        </div>
        <ul class="biz-list">
          {
            industries.map((i) => (
              <li>
                <a class="biz-row" href={`/business/${i.slug}/`}>
                  <Image class="biz-thumb" src={gear[industryThumb[i.slug]].image} alt="" widths={[160, 320]} sizes="5rem" />
                  <span class="biz-name">{i.name.replace(/Wi-Fi/g, 'Wi‑Fi')}</span>
                  <span class="biz-line">{lines[i.slug] ?? i.installs[0]}</span>
                  <svg class="biz-arrow" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="homes frost" id="homes">
        <div class="homes-copy">
          <h3 class="h3">For your home</h3>
          <p>TVs mounted level with the wires inside the wall, home theaters, music in every room, and Wi-Fi that reaches the back patio.</p>
          <ul class="homes-tags" aria-label="Home services">
            <li class="pill pill--static">TV mounting from $150</li>
            <li class="pill pill--static">Home theater</li>
            <li class="pill pill--static">Whole-home audio</li>
            <li class="pill pill--static">Smart home</li>
            <li class="pill pill--static">Home Wi-Fi</li>
          </ul>
        </div>
        <a class="btn btn--ghost" href="/services/">Home services</a>
      </div>
    </div>
  </section>

  <Owner />

  <Reviews mode="one" />

  <CtaBand href={survey} />
</Layout>
