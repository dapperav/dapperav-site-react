---
/**
 * Homepage — taste-skill direction "Type and nothing else" (seed 1900889380), brand palette + type kept.
 * Notes: .taste-skill/notes.md. Every section is its own colour field ("colour by chapter"); the header
 * takes each chapter's ground and ink. Found pictures are credited in the footer and never shown as jobs.
 */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { industries } from '../data/industries';
import { areas } from '../data/areas';
import reviewsData from '../data/reviews.json';
import markPortrait from '../assets/mark-portrait.jpg';
import fireplaceMount from '../assets/gallery/fireplace-mount.jpg';
import hifiRack from '../assets/gallery/hifi-rack.jpg';
import brazos from '../assets/found/brazos-river-south-of-sugar-land-texas.jpg';
import rack from '../assets/found/rear-of-rack-at-nersc-data-center.jpg';
import closet from '../assets/found/cable-closet.jpg';
import courthouse from '../assets/found/fort-bend-county-courthouse-richmond-texas-dsc.jpg';
import bridge from '../assets/found/old-railway-bridge-over-the-brazos-river.jpg';

const survey = (service: string) => `/quote/?service=${encodeURIComponent(service)}`;
const surveyFor = (slug: string) =>
  survey(slug === 'networks-wifi' || slug === 'structured-cabling' ? 'Managed IT / Networking (Business)' : 'Commercial AV');

const brands = ['Ubiquiti UniFi', 'Microsoft 365', 'Samsung', 'LG', 'Sonos', 'Epson', 'Klipsch'];

type Review = { author: string; rating: number; text: string; when: string };
const reviews = (reviewsData.reviews as Review[]) ?? [];
const letter = reviews.find((r) => r.author.startsWith('Kenneth')) ?? reviews[0];
const ps = reviews.find((r) => r !== letter);
// Letter form: first sentence pulled up, the rest as paragraphs (Google's text, unedited)
const sentences = letter ? (letter.text.match(/[^.!?]+[.!?]+/g) ?? [letter.text]) : [];
const opening = sentences[0]?.trim() ?? '';
const rest = sentences.slice(1).map((s) => s.trim());
const half = Math.ceil(rest.length / 2);
const restParas = [rest.slice(0, half).join(' '), rest.slice(half).join(' ')].filter(Boolean);

const steps = [
  { line: 'First, call or text.', note: `${site.phone}. I reply within one business day, usually sooner.` },
  { line: 'Then I walk your site.', note: 'A free 30–45 minute survey. Every screen, drop and camera angle gets noted.' },
  { line: 'You get an itemized proposal.', note: 'Equipment options at honest prices. Nothing padded, nothing hidden.' },
  { line: 'I install around your hours.', note: 'Before open, after close or on a weekend. Then I look after it.' },
];
---

<Layout
  title="Commercial AV & Business IT in Fort Bend County | Dapper AV"
  description="Commercial AV, business Wi-Fi, cameras and managed IT for Fort Bend County businesses, plus TV mounting and home theater. Free site surveys."
>
  <!-- ── Hero: colour field, two-ink statement ───────────────────────── -->
  <section class="chapter hero-field" data-field="#3b1005" data-ink="#f7f0e0">
    <h1 class="font-display hero-statement">
      <span class="hero-line">Everything</span>
      <span class="hero-line text-gold">with a cable.</span>
    </h1>
    <div class="hero-foot">
      <p class="hero-support">
        TVs, sound, Wi-Fi and cameras for Fort Bend County businesses, installed and looked after by one local
        person.
      </p>
      <div class="hero-actions">
        <a href={survey('Commercial AV')} class="btn-flat btn-lg">Book a free site survey</a>
        <a href="/services/" class="link-plain">Homeowner? See home services</a>
      </div>
    </div>
  </section>

  <!-- ── Features: capabilities at poster scale ──────────────────────── -->
  <section class="chapter bg-gold text-espresso" data-field="#f0b010" data-ink="#3b1005">
    <div class="page-wrap section-pad-xl">
      <div class="caps-list">
        <h2 class="font-display caps-row caps-heading">What I install</h2>
        {
          industries.map((ind) => (
            <a href={`/business/${ind.slug}/`} class="caps-row caps-item" data-reveal>
              <span class="font-display caps-name">{ind.name}</span>
              <span class="caps-desc">{ind.installs.slice(0, 2).join('. ')}.</span>
            </a>
          ))
        }
        <a href="/services/" class="caps-row caps-item" data-reveal>
          <span class="font-display caps-name">Homes, too</span>
          <span class="caps-desc">TV mounting from $150, home theaters, whole-home audio and home Wi-Fi.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── One moving picture: the Brazos ─────────────────────────────── -->
  <section class="chapter picture-band" data-field="#2b0c03" data-ink="#f7f0e0" aria-label="The Brazos River">
    <div class="picture-band-frame">
    <Image
      src={brazos}
      alt="The Brazos River winding through green land south of Sugar Land, seen from the air"
      widths={[800, 1400, 1920]}
      sizes="100vw"
      class="picture-band-img"
    />
    </div>
    <p class="picture-band-caption">The Brazos, south of Sugar Land. Every job I take is within an hour of it.</p>
  </section>

  <!-- ── How it works: lines that step across, with the survey picker ── -->
  <section class="chapter bg-espresso text-cream" data-field="#3b1005" data-ink="#f7f0e0">
    <div class="page-wrap section-pad-xl">
      <h2 class="sr-only">How a job goes</h2>
      <ol class="stair">
        {
          steps.map((s, i) => (
            <li class={`stair-step stair-${i + 1}`}>
              <p class={`font-display stair-line ${i === steps.length - 1 ? 'text-gold' : ''}`} data-reveal>
                {s.line}
              </p>
              <p class="stair-note" data-reveal>
                {s.note}
              </p>
              {i === 1 && (
                <div class="picker">
                  <p class="picker-q">What kind of space is it?</p>
                  <div class="picker-chips" role="radiogroup" aria-label="Kind of space">
                    {industries.map((ind, k) => (
                      <label class="chip">
                        <input type="radio" name="space" value={ind.slug} checked={k === 0} />
                        <span>{ind.name}</span>
                      </label>
                    ))}
                  </div>
                  {industries.map((ind) => (
                    <div class="picker-panel" data-for={ind.slug}>
                      <div>
                        <p class="picker-h">On the survey I check</p>
                        <ul class="picker-list">
                          {ind.installs.map((x) => (
                            <li>{x}</li>
                          ))}
                        </ul>
                      </div>
                      <div>
                        <p class="picker-h">What moves the price</p>
                        <ul class="picker-list">
                          {ind.costDrivers.map((x) => (
                            <li>{x}</li>
                          ))}
                        </ul>
                        <a href={surveyFor(ind.slug)} class="btn-flat mt-8">
                          Book this survey
                        </a>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── The closet: what most businesses have, and what it should look like ── -->
  <section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">Most cable closets look like the one on the right.</h2>
      <div class="closet-pair">
        <figure data-reveal>
          <Image
            src={rack}
            alt="A tidy server rack with cables bundled, labeled and routed down the side"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            class="closet-img"
          />
          <figcaption>Bundled, labeled and documented. This is what yours should look like.</figcaption>
        </figure>
        <figure data-reveal>
          <Image
            src={closet}
            alt="A cable closet with tangled yellow, red and blue network cables"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            class="closet-img"
          />
          <figcaption>The usual closet. When something breaks, nobody can tell which cable it is.</figcaption>
        </figure>
      </div>
      <p class="closet-note">Both photos are other people's racks, credited at the bottom of the page. Neither is my job.</p>
    </div>
  </section>

  <!-- ── About: side facts, wide paragraph ──────────────────────────── -->
  <section class="chapter bg-parchment text-espresso" data-field="#efe3cb" data-ink="#3b1005">
    <div class="page-wrap section-pad about-grid">
      <div class="about-side">
        <Image
          src={markPortrait}
          alt="Mark Immler, owner of Dapper AV Solutions, in a blue plaid blazer"
          widths={[400, 640]}
          sizes="(min-width: 1024px) 26vw, 80vw"
          class="about-portrait"
        />
        <dl class="about-facts">
          <div><dt>Owner</dt><dd>Mark Immler</dd></div>
          <div><dt>Based in</dt><dd>Richmond, Texas</dd></div>
          <div><dt>Installing AV</dt><dd>18 years</dd></div>
          <div><dt>Running managed IT</dt><dd>5 years</dd></div>
        </dl>
      </div>
      <div class="about-main">
        <h2 class="font-display h-section">One person, start to finish.</h2>
        <p class="about-para">
          I'm Mark Immler. I've installed AV for more than 18 years and my day job is IT director, so the network
          under your TVs and cameras gets the same care as the screens. There is no call center and no
          subcontractor: the person who surveys your site installs it, and answers the phone when something needs
          looking at.
        </p>
        <div class="about-lists">
          <div>
            <p class="about-list-h">Works on</p>
            <ul>{brands.map((b) => <li>{b}</li>)}</ul>
          </div>
          <div>
            <p class="about-list-h">Serves</p>
            <ul>
              {
                areas.map((a) => (
                  <li>
                    <a href={`/areas/${a.slug}/`}>{a.city}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="about-pics">
          <figure>
            <Image
              src={courthouse}
              alt="The Fort Bend County Courthouse in Richmond, Texas, with its green dome"
              widths={[500, 800]}
              sizes="(min-width: 1024px) 26vw, 90vw"
              class="about-pic"
            />
            <figcaption>Fort Bend County Courthouse, Richmond.</figcaption>
          </figure>
          <figure>
            <Image
              src={bridge}
              alt="The old steel railway bridge over the Brazos River in Richmond, Texas"
              widths={[500, 800]}
              sizes="(min-width: 1024px) 26vw, 90vw"
              class="about-pic"
            />
            <figcaption>The old railway bridge over the Brazos.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Work: oversized visual, small cluster (real installs only) ──── -->
  <section class="chapter bg-cream text-espresso work" data-field="#f7f0e0" data-ink="#3b1005">
    <h2 class="sr-only">Recent installs</h2>
    <article class="work-block">
      <div class="work-visual work-visual--tall">
        <Image
          src={fireplaceMount}
          alt="TV and soundbar mounted above a white mantel and tiled fireplace with no visible wires"
          widths={[700, 1100, 1500]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="work-img"
          style="object-position: top"
        />
      </div>
      <div class="work-cluster" data-reveal>
        <h3 class="font-display work-title">Over-mantel TV and soundbar</h3>
        <p class="work-desc">
          Dead center over the fireplace, soundbar aligned under it, every wire inside the wall. A Fort Bend County
          living room.
        </p>
      </div>
    </article>
    <article class="work-block work-block--second">
      <div class="work-visual">
        <Image
          src={hifiRack}
          alt="Walnut cabinet with a Pioneer turntable, reel-to-reel tape deck and a modern Yamaha receiver"
          widths={[700, 1100, 1500]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="work-img"
        />
      </div>
      <div class="work-cluster" data-reveal>
        <h3 class="font-display work-title">Vintage hi-fi, wired for today</h3>
        <p class="work-desc">
          A Pioneer turntable and reel-to-reel running through a modern Yamaha receiver. <a href="/work/">More installs</a>
        </p>
      </div>
    </article>
  </section>

  <!-- ── Letter: one real review, set like a letter ─────────────────── -->
  {
    letter && (
      <section class="chapter bg-parchment text-espresso" data-field="#efe3cb" data-ink="#3b1005">
        <div class="page-wrap section-pad letter">
          <h2 class="sr-only">A review from Google</h2>
          <p class="font-display letter-open">{opening}</p>
          {restParas.map((p) => (
            <p class="letter-body">{p}</p>
          ))}
          <p class="letter-sign">
            {letter.author}
            <span>Google review{letter.when ? `, ${letter.when}` : ''}</span>
          </p>
          {ps && (
            <p class="letter-ps">
              P.S. From a business customer, {ps.author}: “{ps.text}”
            </p>
          )}
        </div>
      </section>
    )
  }

  <!-- ── CTA: the idea again, inverted ──────────────────────────────── -->
  <section class="chapter cta-field" data-field="#3b1005" data-ink="#f7f0e0">
    <h2 class="font-display cta-statement">
      <span>One number.</span>
      <span class="text-gold">Every cable.</span>
    </h2>
    <div class="cta-foot">
      <p class="cta-support">
        Call or text <a href={site.phoneHref}>{site.phone}</a>. The person who answers is the person who installs.
      </p>
      <a href={survey('Commercial AV')} class="btn-flat btn-lg">Book a free site survey</a>
    </div>
  </section>
</Layout>

<style is:global set:html={industries.map((i) => `.picker:has(input[value="${i.slug}"]:checked) .picker-panel[data-for="${i.slug}"]{display:grid}`).join('')} />
