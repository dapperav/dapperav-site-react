---
/**
 * Homepage, Option 1 "Calm, one column" (Mark picked it 2026-11-20): one centre line, one idea per screen,
 * everything in cards, one gold button per screen. Section styles: src/styles/home.css.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import HomeSections from '../components/HomeSections.astro';
import HeroTabs from '../components/HeroTabs.astro';
import RackMap from '../components/RackMap.astro';
import { services } from '../data/site';
import '../styles/home.css';

const survey = `/quote/?service=${encodeURIComponent('Commercial AV')}`;
const homeQuote = `/quote/?service=${encodeURIComponent('TV Mounting & Installation')}`;
const home = ['tv-mounting', 'home-theater', 'whole-home-audio'].map((id) => services.find((s) => s.id === id)!);
const shortName: Record<string, string> = { 'tv-mounting': 'TV mounting', 'home-theater': 'Home theater', 'whole-home-audio': 'Whole-home audio' };
---

<Layout
  title="Commercial AV & Managed IT, Richmond TX | Dapper AV"
  description="Commercial AV, business Wi-Fi, cameras and managed IT for Fort Bend County businesses, plus TV mounting and home theater. Free site surveys."
>
  <div class="home-page">
    <Hero
      tag="Dapper AV · Richmond, TX"
      page={false}
      center={true}
      lead="One local contact for"
      main="everything with a cable."
      lede="AV, Wi-Fi, cameras, cabling and managed IT for Fort Bend County businesses, from one company that also looks after it."
      actions={[{ href: survey, label: 'Book a free site survey' }]}
    >
      <p class="hero-aside">Homeowner? <a class="text-link" href="#doors">See home services</a>.</p>
      <HeroTabs />
    </Hero>

    <section class="section" id="doors" aria-labelledby="doors-title">
      <div class="container">
        <div class="home-head">
          <h2 class="h2" id="doors-title">For your business, or your home</h2>
          <p class="lede">Commercial work comes first, and homes get the same standard of install.</p>
        </div>
        <div class="home-doors">
          <div class="home-door home-door--biz on-dark">
            <h3 class="home-door-title">For your business</h3>
            <p>Restaurants, offices, retail, signage, business Wi-Fi and cabling. Installed around your hours, then looked after.</p>
            <ul class="home-door-list">
              <li><strong>Free site survey</strong><span>30–45 min</span></li>
              <li><strong>Itemized price before any work</strong><span>In writing</span></li>
              <li><strong>Care plans afterward</strong><span>Month to month</span></li>
            </ul>
            <div class="home-door-actions">
              <a class="btn btn--primary" href={survey}>Book a free site survey</a>
              <a class="text-link" href="/business/">See business services</a>
            </div>
          </div>
          <div class="home-door home-door--home">
            <h3 class="home-door-title">For your home</h3>
            <p>TVs mounted level with the wires hidden, home theaters and music in every room.</p>
            <ul class="home-door-list">
              {home.map((s) => <li><strong>{shortName[s.id]}</strong><span>{s.price}</span></li>)}
            </ul>
            <div class="home-door-actions">
              <a class="btn btn--ghost" href={homeQuote}>Get a free quote</a>
              <a class="text-link" href="/services/">See home services</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <RackMap />

    <HomeSections />
    <CtaBand href={survey} />
  </div>
</Layout>
