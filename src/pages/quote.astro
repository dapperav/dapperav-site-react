---
/**
 * Quote / site survey. Restyled only: every form element id, input name and the inline script
 * below are load-bearing (Web3Forms submit, ?service= pre-select, business mode, GA4 generate_lead).
 */
import Layout from '../layouts/Layout.astro';
import { site, serviceAreas, quoteFormOptions, WEB3FORMS_ACCESS_KEY } from '../data/site';
import '../styles/home.css';
import OpenNow from '../components/OpenNow.astro';
---

<Layout
  title="Request a Free Site Survey or Quote | Dapper AV"
  description="Free site survey and itemized quote for commercial AV, networks and managed IT, or home AV, in Fort Bend County. Reply within one business day."
>
  <section class="quote-page" aria-labelledby="quote-title">
    <div class="container">
      <div class="home-head quote-head">
        <h1 class="quote-title" id="quote-title">Book a free site survey</h1>
        <p class="lede">
          Tell us about the space. We reply within one business day to set a time for
          a free 30–45 minute visit.
        </p>
      </div>
    </div>
    <div class="container quote-grid">
      <div>
        <div class="quote-card">
          <div>
            <form id="quote-form" novalidate>
              <div class="form-grid">
                <div>
                  <label for="qf-name" class="field-label">Name <span>(required)</span></label>
                  <input id="qf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" class="field" />
                </div>
                <div>
                  <label for="qf-email" class="field-label">Email <span>(phone or email)</span></label>
                  <input id="qf-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" class="field" />
                </div>
                <div>
                  <label for="qf-phone" class="field-label">Phone <span>(phone or email)</span></label>
                  <input id="qf-phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 555-5555" class="field" />
                </div>
                <div>
                  <label for="qf-company" class="field-label">Business name <span>(optional)</span></label>
                  <input id="qf-company" name="company" type="text" autocomplete="organization" placeholder="Optional" class="field" />
                </div>
                <div>
                  <label for="qf-service" class="field-label">Service needed <span>(required)</span></label>
                  <select id="qf-service" name="service" required class="field">
                    <option value="" selected disabled>Select a service…</option>
                    {quoteFormOptions.services.map((s) => <option value={s}>{s}</option>)}
                  </select>
                </div>
                <div>
                  <label for="qf-timeline" class="field-label">Timeline</label>
                  <select id="qf-timeline" name="timeline" class="field">
                    <option value="" selected>When would you like this done?</option>
                    {quoteFormOptions.timelines.map((t) => <option value={t}>{t}</option>)}
                  </select>
                </div>
                <div>
                  <label for="qf-budget" class="field-label">Budget</label>
                  <select id="qf-budget" name="budget" class="field">
                    <option value="" selected>Rough budget range (optional)</option>
                    {quoteFormOptions.budgets.map((b) => <option value={b}>{b}</option>)}
                  </select>
                </div>
              </div>

              <div class="form-full">
                <label for="qf-message" class="field-label">Project details <span>(optional)</span></label>
                <textarea
                  id="qf-message"
                  name="message"
                  rows="5"
                  placeholder="One line is enough: the room, what you have or want, and what you're trying to fix."
                  class="field"></textarea>
              </div>

              <!-- Honeypot: hidden from humans, catnip for bots -->
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] opacity-0" />

              <p id="qf-tvtip" class="form-tip">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect><circle cx="12" cy="12" r="3"></circle><path d="M8 5.5l1.5-2h5l1.5 2"></path></svg>
                <span><strong>Fastest quote:</strong> tell us the TV size, the wall (drywall, brick or stone) and where the nearest outlet is. For most TV mounts, that is all we need.</span>
              </p>

              <p id="qf-hint" class="form-hint hidden" role="alert"></p>

              <div class="form-submit">
                <button type="submit" id="qf-submit" class="btn btn--primary btn--lg">Send request</button>
                <p>We only use your details to answer this request. No newsletters, no spam.</p>
              </div>
            </form>

            <!-- Success state -->
            <div id="qf-success" class="form-state hidden" role="status">
              <p id="qf-success-title" tabindex="-1" class="form-state-title">Request received.</p>
              <p>
                Got it. We reply within one business day to set up the visit.
              </p>
            </div>

            <!-- Error state -->
            <div id="qf-error" class="form-state form-hint hidden" role="alert">
              <p>Something went wrong sending your request.</p>
              <p>
                Please email us instead at
                <a href={`mailto:${site.email}`}>{site.email}</a>.
              </p>
            </div>
          </div>
        </div>
      </div>

      <aside class="quote-aside quote-aside-card on-dark" aria-label="About the reply">
        <div>
          <div class="aside-block">
            <div class="aside-owner">
              <div>
                <p class="aside-owner-name">Dapper AV Solutions</p>
                <p>Local to Fort Bend County</p>
              </div>
            </div>
            <ul class="aside-list">
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li>{site.hours}</li>
              <li><OpenNow /></li>
            </ul>
          </div>
          <div class="aside-block">
            <h2 class="aside-title">What happens next</h2>
            <ol class="aside-list aside-steps">
              <li>A reply within one business day.</li>
              <li>A free 30–45 minute visit at a time that suits you.</li>
              <li>An itemized quote in writing, before anything is installed.</li>
            </ol>
          </div>
          <div class="aside-block">
            <h2 class="aside-title">Where we work</h2>
            {
              serviceAreas.map((a) => (
                <p class="aside-list">
                  <span>
                    <strong>{a.county}:</strong> {a.cities.join(', ')}
                  </span>
                </p>
              ))
            }
            <p class="aside-list">Outside that? Ask, we can often make it work. Jobs well outside the area carry a modest trip fee, always quoted up front.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ accessKey: WEB3FORMS_ACCESS_KEY }}>
  const form = document.getElementById('quote-form');
  const successBox = document.getElementById('qf-success');
  const errorBox = document.getElementById('qf-error');
  const hint = document.getElementById('qf-hint');
  const submitBtn = document.getElementById('qf-submit');

  // Pre-select service from ?service= links. Exact match first; the fuzzy fallback skips the
  // blank placeholder (its '' value is contained in every string, so it used to always win).
  const preselect = new URLSearchParams(location.search).get('service');
  if (preselect) {
    const select = form.elements.service;
    const opts = [...select.options].filter((o) => o.value);
    const p = preselect.toLowerCase();
    const match = opts.find((o) => o.value === preselect) ?? opts.find((o) => p.includes(o.value.toLowerCase().split(' ')[0]));
    select.value = match ? match.value : 'Other';
  }
  const details = new URLSearchParams(location.search).get('details');
  if (details && !form.elements.message.value) form.elements.message.value = details.slice(0, 500);

  // Business visitors get business wording instead of the homeowner TV-mount tips.
  const homePlaceholder = form.elements.message.placeholder;
  const isBusiness = (v) => v === 'Commercial AV' || v === 'Managed IT / Networking (Business)';
  const setMode = () => {
    const biz = isBusiness(form.elements.service.value);
    document.querySelector('main h1').textContent = biz || !form.elements.service.value ? 'Book a free site survey' : 'Tell us about your project';
    document.getElementById('qf-tvtip').hidden = biz;
    form.elements.message.placeholder = biz
      ? "What kind of space is it, and what's not working? e.g. 12-table restaurant, 4 TVs on the bar, Wi-Fi drops on Fridays"
      : homePlaceholder;
  };
  setMode();
  form.elements.service.addEventListener('change', setMode);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hint.classList.add('hidden');
    errorBox.classList.add('hidden');

    // Phone OR email is enough; the browser checks the rest (name, service, email format).
    const reach = !!(form.elements.phone.value.trim() || form.elements.email.value.trim());
    for (const el of [form.elements.name, form.elements.email, form.elements.phone, form.elements.service]) {
      const bad = !el.validity.valid || ((el.name === 'phone' || el.name === 'email') && !reach);
      el.toggleAttribute('aria-invalid', bad);
      if (bad) el.setAttribute('aria-describedby', 'qf-hint');
      else el.removeAttribute('aria-describedby');
    }
    if (!form.checkValidity() || !reach) {
      hint.textContent = form.elements.email.validity.typeMismatch
        ? 'That email address looks incomplete. Check it, or leave it blank and add a phone number.'
        : 'Please add your name, the service, and a phone number or email so we can reach you.';
      hint.classList.remove('hidden');
      (form.querySelector('[aria-invalid]') ?? form.elements.phone).focus();
      return;
    }

    if (accessKey.startsWith('REPLACE_WITH')) {
      // Form service not configured yet — fail loudly toward a human channel.
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `Quote request from ${data.name}${data.company ? ` (${data.company})` : ''} — ${data.service}`,
          from_name: 'dapperav.com quote form',
          ...data,
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
      document.getElementById('qf-success-title').focus();
      // GA4 lead event — no personal details, just what was asked for.
      window.gtag?.('event', 'generate_lead', { service: data.service, is_business: isBusiness(data.service) || !!data.company });
      successBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    } catch (err) {
      console.error('Quote form submission failed:', err);
      errorBox.classList.remove('hidden');
      errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send request';
    }
  });
</script>
