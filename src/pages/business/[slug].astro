---
/** Business pages — same system as the homepage (taste-skill, "Type and nothing else"). */
import Layout from '../../layouts/Layout.astro';
import ClosetPair from '../../components/ClosetPair.astro';
import PictureBand from '../../components/PictureBand.astro';
import PageHero from '../../components/PageHero.astro';
import OwnerPanel from '../../components/OwnerPanel.astro';
import Staircase from '../../components/Staircase.astro';
import Letter from '../../components/Letter.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries } from '../../data/industries';
import { site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const others = industries.filter((i) => i.slug !== industry.slug);
// Cost question answered honestly from the price drivers — no invented dollar figures
const faqs = [
  {
    q: industry.costQuestion,
    a: `It depends on the space. The biggest factors: ${industry.costDrivers
      .slice(0, 3)
      .map((d) => d.charAt(0).toLowerCase() + d.slice(1))
      .join('; ')}. Every proposal is itemized after a free 30–45 minute site survey, so you see what each piece costs before anything is installed.`,
  },
  ...industry.faqs,
];
const isIT = industry.slug === 'networks-wifi' || industry.slug === 'structured-cabling';
const quoteHref = `/quote/?service=${encodeURIComponent(isIT ? 'Managed IT / Networking (Business)' : 'Commercial AV')}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: industry.headline,
  serviceType: isIT ? 'Business network and cabling installation' : 'Commercial audio visual installation',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Fort Bend County, TX' },
  description: industry.intro,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={industry.metaTitle} description={industry.metaDescription} extraSchema={[serviceSchema, faqSchema]}>
  <PageHero
    lines={industry.heroLines}
    support={industry.metaDescription}
    primary={{ href: quoteHref, label: 'Book a free site survey' }}
    secondary={{ href: site.phoneHref, label: `Call ${site.phone}` }}
  />

  <section class="chapter bg-gold text-espresso" data-field="#f0b010" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">What I install.</h2>
      <p class="intro-lead mt-8">{industry.intro}</p>
      <ul class="install-list font-display">
        {
          industry.installs.map((x) => (
            <li data-reveal>{x}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <ClosetPair />

  <OwnerPanel reasons={industry.reasons} />

  <PictureBand />

  <Staircase drivers={industry.costDrivers} costQuestion={industry.costQuestion} />

  <Letter field="cream" />

  <FaqSection items={faqs} heading="What owners ask first." field="parchment" />

  <section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">More for business.</h2>
      <div class="big-links">
        {
          others.map((o) => (
            <a href={`/business/${o.slug}/`}>{o.name}</a>
          ))
        }
        <a href="/business/#care-plans">Managed IT and care plans</a>
      </div>
    </div>
  </section>

  <CtaBand line1="Let's look at" line2="your space." href={quoteHref} />
</Layout>
