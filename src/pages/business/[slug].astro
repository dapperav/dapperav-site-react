---
/** One page per kind of business buyer. Light hero with what the survey checks; installs on espresso. */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Crumbs from '../../components/Crumbs.astro';
import GearPhoto from '../../components/GearPhoto.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries } from '../../data/industries';
import type { GearKey } from '../../data/gear';
import { site } from '../../data/site';
import { areas } from '../../data/areas';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const others = industries.filter((i) => i.slug !== industry.slug);
// Cost question answered honestly from the price drivers: no invented dollar figures
const faqs = [
  {
    q: industry.costQuestion,
    a: `It depends on the space. The biggest factors: ${industry.costDrivers
      .slice(0, 3)
      .map((d) => d.charAt(0).toLowerCase() + d.slice(1))
      .join('; ')}. Every proposal is itemized after a free 30–45 minute site survey, so you see what each piece costs before anything is installed.`,
  },
  ...industry.faqs,
];
const isIT = industry.slug === 'networks-wifi' || industry.slug === 'structured-cabling';
const quoteHref = `/quote/?service=${encodeURIComponent(isIT ? 'Managed IT / Networking (Business)' : 'Commercial AV')}`;

// Which photo stands in for this kind of job (gear or a kind of space, never presented as the job).
const gearFor: Record<string, { item: GearKey; caption: string }> = {
  'restaurants-bars': { item: 'bar', caption: 'TV walls, zoned sound and a guest network kept apart from the POS: the core of a bar install.' },
  'offices-conference-rooms': { item: 'meeting', caption: 'One display, one camera, one cable or tap to start, and the network behind it planned at the same time.' },
  'retail-showrooms': { item: 'camera', caption: 'Cameras that record locally, so there are no per-camera cloud fees.' },
  'digital-signage': { item: 'barTv', caption: 'Screens mounted level, wired out of sight and fed by a connection that stays up.' },
  'networks-wifi': { item: 'ports', caption: 'Wired backhaul for every UniFi access point, with every port numbered and documented.' },
  'structured-cabling': { item: 'panel', caption: 'Every drop ends on a numbered patch panel port, labeled and documented at closeout.' },
};
const g = gearFor[industry.slug] ?? gearFor['networks-wifi'];

const pageUrl = `${site.url}/business/${industry.slug}/`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: industry.headline,
  url: pageUrl,
  serviceType: isIT ? 'Business network and cabling installation' : 'Commercial audio visual installation',
  provider: { '@id': `${site.url}/#business` },
  audience: { '@type': 'BusinessAudience', audienceType: 'Businesses' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Fort Bend County, TX' },
    ...areas.map((a) => ({ '@type': 'City', name: `${a.city}, TX` })),
  ],
  description: industry.metaDescription,
  offers: {
    '@type': 'Offer',
    name: 'Free site survey',
    price: '0',
    priceCurrency: 'USD',
    description: 'A free 30 to 45 minute on-site survey, then an itemized custom quote.',
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Business', item: `${site.url}/business/` },
    { '@type': 'ListItem', position: 3, name: industry.name, item: pageUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const check = 'M4 12.5l5 5L20 6.5';
---

<Layout title={industry.metaTitle} description={industry.metaDescription} extraSchema={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <Hero
    tone="light"
    alt
    main={`${industry.heroLines[0]} ${industry.heroLines[1]}`}
    lede={`${industry.metaDescription} Afterward, you call me, not a ticket line.`}
    actions={[
      { href: quoteHref, label: 'Book a free site survey', arrow: true },
      { href: site.phoneHref, label: `Call ${site.phone}`, variant: 'ghost' },
    ]}
  >
    <Crumbs slot="crumbs" items={[{ href: '/business/', label: 'Business' }, { label: industry.name }]} />
    <aside slot="aside" class="bezel bezel--light hero-card" aria-labelledby="checks-title">
      <div class="bezel-core">
        <h2 class="side-title" id="checks-title">What the free survey checks</h2>
        <ul class="checklist checklist--light">
          {industry.costDrivers.map((d) => <li>{d}</li>)}
        </ul>
        <p class="side-note">These are also what move the price. You get them itemized, line by line, before anything is installed.</p>
      </div>
    </aside>
  </Hero>

  <section class="section on-dark pinstripe" aria-labelledby="installs-title">
    <div class="container installs">
      <div>
        <h2 class="h2" id="installs-title">What I install</h2>
        <p class="lede">{industry.intro}</p>
      </div>
      <ul class="install-grid">
        {
          industry.installs.map((x, i) => (
            <li data-reveal style={`--d:${i * 50}ms`}>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
              <span>{x}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section grooves" aria-labelledby="why-title">
    <div class="container standard">
      <GearPhoto item={g.item} caption={g.caption} shape={g.item === 'runs' ? 'tall' : 'wide'} sizes="(min-width: 1024px) 50vw, 100vw" />
      <div>
        <h2 class="h2" id="why-title">Why one installer</h2>
        <ul class="reasons">
          {
            industry.reasons.map((r) => (
              <li data-reveal>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faqs} heading="What owners ask first" lede="Straight answers. Anything else, ask me during the survey.">
    <div class="stack-actions">
      <a class="btn btn--secondary" href={quoteHref}>Book a free site survey</a>
    </div>
  </Faq>

  <section class="section section--paper-2" aria-labelledby="more-title">
    <div class="container">
      <h2 class="h3" id="more-title">More for business</h2>
      <ul class="chips more-chips">
        {
          others.map((o) => (
            <li>
              <a class="pill" href={`/business/${o.slug}/`}>
                {o.name}
              </a>
            </li>
          ))
        }
        <li><a class="pill" href="/business/#care-plans">Managed IT and care plans</a></li>
      </ul>
      <p class="more-serving">
        Serving {areas.map((a, i) => (
          <>
            <a class="text-link" href={`/areas/${a.slug}/`}>{a.city}</a>{i < areas.length - 2 ? ', ' : i === areas.length - 2 ? ' and ' : '.'}
          </>
        ))}{' '}
        <a class="text-link" href="/work/">See real installs</a>.
      </p>
    </div>
  </section>

  <CtaBand title="Let's look at your space" href={quoteHref} />
</Layout>
