---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import OwnerPanel from '../../components/OwnerPanel.astro';
import Record from '../../components/Record.astro';
import SurveySteps from '../../components/SurveySteps.astro';
import { industries } from '../../data/industries';
import { site } from '../../data/site';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const others = industries.filter((i) => i.slug !== industry.slug);
// Cost question answered honestly from the price drivers — no invented dollar figures
const faqs = [
  {
    q: industry.costQuestion,
    a: `It depends on the space. The biggest factors: ${industry.costDrivers
      .slice(0, 3)
      .map((d) => d.charAt(0).toLowerCase() + d.slice(1))
      .join('; ')}. Every proposal is itemized after a free 30–45 minute site survey, so you see what each piece costs before anything is installed.`,
  },
  ...industry.faqs,
];
const quoteHref = `/quote/?service=${encodeURIComponent('Commercial AV')}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: industry.headline,
  serviceType: 'Commercial audio visual installation',
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Fort Bend County, TX' },
  description: industry.intro,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={industry.metaTitle} description={industry.metaDescription} extraSchema={[serviceSchema, faqSchema]}>
  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="pinstripe relative overflow-hidden bg-espresso">
    <Record class="max-md:hidden right-[-13rem] top-1/2 w-[42rem] -translate-y-1/2 lg:right-[-10rem]" />
    <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-20 sm:px-8 md:pt-48 md:pb-24">
      <p class="flex items-center gap-3 text-xs font-semibold tracking-[0.28em] text-gold uppercase">
        <span class="block h-2 w-2 rounded-full bg-gold" aria-hidden="true"></span>
        <a href="/business/" class="link-draw">For business</a> · {industry.name}
      </p>
      <h1
        class="font-display mt-6 max-w-3xl text-4xl leading-[1.1] font-semibold text-balance text-cream sm:text-5xl lg:text-6xl"
      >
        {industry.headline}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-cream/75">
        {industry.intro}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={quoteHref}
          class="btn-sheen rounded-full bg-gold px-8 py-4 text-base font-semibold text-espresso transition-colors duration-300 hover:bg-gold-deep"
        >
          Request a Free Site Survey
        </a>
        <a
          href={site.phoneHref}
          class="glass-dark rounded-full px-8 py-4 text-base font-medium text-cream transition-colors duration-300 hover:text-gold"
        >
          Call {site.phone}
        </a>
      </div>
      <p class="mt-6 text-sm text-cream/55">
        Serving businesses in Richmond, Rosenberg, Fulshear, Sugar Land, Stafford & Katy. Custom-quoted after a
        free site survey.
      </p>
    </div>
  </section>

  <!-- ── What we install ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-28">
    <div class={`grid items-center gap-12 ${industry.photo ? 'lg:grid-cols-2' : ''}`}>
      <div>
        <SectionHeading eyebrow="What we install" title="Everything the space needs, from one vendor" align="left" />
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            industry.installs.map((f, i) => (
              <li class="glass flex items-start gap-3 rounded-2xl p-5 text-sm leading-relaxed" data-reveal style={`--rd: ${(i % 2) * 80}ms`}>
                <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true" />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
      {
        industry.photo && (
          <figure data-reveal>
            <Image
              src={industry.photo.image}
              alt={industry.photo.alt}
              class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
              widths={[480, 768, 1024]}
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
            <figcaption class="mt-4 text-sm text-cocoa">{industry.photo.caption}</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <OwnerPanel reasons={industry.reasons} />

  <SurveySteps drivers={industry.costDrivers} />

  <FaqSection items={faqs} lead="What business owners ask before a site survey." />

  <!-- ── Other business pages ─────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
    <h2 class="text-center text-xs font-semibold tracking-[0.22em] text-gold-ink uppercase">More for business</h2>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {
        others.map((o) => (
          <a href={`/business/${o.slug}/`} class="glass rounded-full px-5 py-2.5 text-sm font-medium transition-colors duration-300 hover:text-gold-ink">
            {o.name}
          </a>
        ))
      }
      <a href="/business/" class="glass rounded-full px-5 py-2.5 text-sm font-medium transition-colors duration-300 hover:text-gold-ink">
        Managed IT & care plans
      </a>
    </div>
  </section>

  <ReviewsSection title="What customers are saying" />

  <CtaBand
    href={quoteHref}
    cta="Request a Free Site Survey"
    title="Let's look at your space"
    body={`A free site survey tells us both exactly what your business needs — no obligation. Call or text ${site.phone}, or send the details.`}
  />
</Layout>
