---
/** One page per kind of business buyer, in the calm one-column card layout (2026-11-20). */
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import IndustryCards from '../../components/IndustryCards.astro';
import JobSteps from '../../components/JobSteps.astro';
import ProofRow from '../../components/ProofRow.astro';
import CtaBand from '../../components/CtaBand.astro';
import CableSlider from '../../components/CableSlider.astro';
import WifiToy from '../../components/WifiToy.astro';
import MusicZones from '../../components/MusicZones.astro';
import ClosetHotspots from '../../components/ClosetHotspots.astro';
import CamPlanner from '../../components/CamPlanner.astro';
import MenuBoard from '../../components/MenuBoard.astro';
import MeetingRoom from '../../components/MeetingRoom.astro';
import { industries } from '../../data/industries';
import { site } from '../../data/site';
import { areas } from '../../data/areas';
import '../../styles/home.css';

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
// Cost question answered honestly from the price drivers: no invented dollar figures
const faqs = [
  {
    q: industry.costQuestion,
    a: `It depends on the space. The biggest factors: ${industry.costDrivers
      .slice(0, 3)
      .map((d) => d.charAt(0).toLowerCase() + d.slice(1))
      .join('; ')}. Every proposal is itemized after a free 30–45 minute site survey, so you see what each piece costs before anything is installed.`,
  },
  ...industry.faqs,
];
const isIT = industry.slug === 'networks-wifi' || industry.slug === 'structured-cabling';
const quoteHref = `/quote/?service=${encodeURIComponent(isIT ? 'Managed IT / Networking (Business)' : 'Commercial AV')}`;


const pageUrl = `${site.url}/business/${industry.slug}/`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: industry.headline,
  url: pageUrl,
  serviceType: isIT ? 'Business network and cabling installation' : 'Commercial audio visual installation',
  provider: { '@id': `${site.url}/#business` },
  audience: { '@type': 'BusinessAudience', audienceType: 'Businesses' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Fort Bend County, TX' },
    ...areas.map((a) => ({ '@type': 'City', name: `${a.city}, TX` })),
  ],
  description: industry.metaDescription,
  offers: {
    '@type': 'Offer',
    name: 'Free site survey',
    price: '0',
    priceCurrency: 'USD',
    description: 'A free 30 to 45 minute on-site survey, then an itemized custom quote.',
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Business', item: `${site.url}/business/` },
    { '@type': 'ListItem', position: 3, name: industry.name, item: pageUrl },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const check = 'M4 12.5l5 5L20 6.5';
---

<Layout title={industry.metaTitle} description={industry.metaDescription} extraSchema={[serviceSchema, faqSchema, breadcrumbSchema]}>
  <div class="home-page">
    <Hero
      tag={industry.name}
      center={true}
      main={`${industry.heroLines[0]} ${industry.heroLines[1]}`}
      lede={`${industry.metaDescription} Afterward, the same company supports it, not a ticket line.`}
      actions={[{ href: quoteHref, label: 'Book a free site survey' }]}
    >
      <Crumbs slot="crumbs" items={[{ href: '/business/', label: 'Business' }, { label: industry.name }]} />
      <p class="hero-aside">Care plans are month to month. <a class="text-link" href="/business/#care-plans">See care plans</a>.</p>
      {
        industry.slug === 'networks-wifi' && (
          <div class="wifi-puck" aria-hidden="true">
            <span />
          </div>
        )
      }
    </Hero>

    <section class="section section--alt" aria-labelledby="installs-title">
      <div class="container">
        <div class="home-head">
          <h2 class="h2" id="installs-title">What we install</h2>
          <p class="lede">{industry.intro}</p>
        </div>
        <ul class="home-installs">
          {
            industry.installs.map((x) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={check} /></svg>
                <span>{x}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {industry.slug === 'structured-cabling' && <CableSlider />}
    {industry.slug === 'structured-cabling' && <ClosetHotspots />}
    {industry.slug === 'restaurants-bars' && <MusicZones />}
    {industry.slug === 'networks-wifi' && <WifiToy />}
    {industry.slug === 'retail-showrooms' && <CamPlanner />}
    {industry.slug === 'digital-signage' && <MenuBoard />}
    {industry.slug === 'offices-conference-rooms' && <MeetingRoom />}

    <section class="section" aria-labelledby="why-title">
      <div class="container">
        <div class="home-head">
          <h2 class="h2" id="why-title">Why one company</h2>
          <p class="lede">The survey, the install and the support come from Dapper AV, never a subcontractor.</p>
        </div>
        <div class="home-plans">
          {
            industry.reasons.map((r) => (
              <div class="home-plan home-plan--light">
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            ))
          }
        </div>
        <div class="home-checks on-dark">
          <div>
            <h3>What the free survey checks</h3>
            <p>These are also what move the price. You get them itemized, line by line, before anything is installed.</p>
          </div>
          <ul class="checklist">
            {industry.costDrivers.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <JobSteps href={quoteHref} alt={true} />

    <Faq items={faqs} heading="What owners ask first" lede="Straight answers. Anything else, ask during the survey.">
      <div class="stack-actions">
        <a class="btn btn--primary" href={quoteHref}>Book a free site survey</a>
      </div>
    </Faq>

    <ProofRow />

    <IndustryCards
      heading="More for business"
      lede={`Serving ${areas.map((a) => a.city).join(', ').replace(/, ([^,]*)$/, ' and $1')}.`}
      exclude={industry.slug}
      alt={false}
    />

    <CtaBand title="Let's look at your space" href={quoteHref} />
  </div>
</Layout>
