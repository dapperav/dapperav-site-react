---
/** Business hub — same system as the homepage (taste-skill, "Type and nothing else"). */
import Layout from '../layouts/Layout.astro';
import ClosetPair from '../components/ClosetPair.astro';
import PictureBand from '../components/PictureBand.astro';
import PageHero from '../components/PageHero.astro';
import BigList from '../components/BigList.astro';
import OwnerPanel from '../components/OwnerPanel.astro';
import Staircase from '../components/Staircase.astro';
import Letter from '../components/Letter.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, carePlans } from '../data/site';
import { industries } from '../data/industries';

const managedSurvey = `/quote/?service=${encodeURIComponent('Managed IT / Networking (Business)')}`;

const capabilities = [
  {
    title: 'Business networks on UniFi',
    body: 'Switches, access points and cabling designed for your floor plan, installed clean and documented properly.',
    slug: 'networks-wifi',
  },
  {
    title: 'Cameras you own',
    body: 'UniFi Protect cameras with local recording and phone viewing. No monthly per-camera cloud fees.',
  },
  {
    title: 'Security and separate networks',
    body: 'Firewall rules and VLANs that keep the POS, cameras, staff and guests apart, with dedicated Wi-Fi for each.',
  },
  {
    title: 'Microsoft 365',
    body: 'Tenant setup, migrations and day-to-day users, licenses and email, done right from the start.',
  },
  {
    title: 'Cabling and low voltage',
    body: 'Data drops, racks and the rough-in for new builds and remodels, as your sub or direct.',
    slug: 'structured-cabling',
  },
  {
    title: 'Commercial AV',
    body: 'Video walls, signage, conference rooms and bar TVs, serviced by the same person who runs your network.',
    slug: 'restaurants-bars',
  },
];
---

<Layout
  title="Managed IT, Networks & Commercial AV | Dapper AV"
  description="An IT department for Fort Bend County businesses: UniFi networks and cameras, cabling, Microsoft 365 and commercial AV. Installed, then managed."
>
  <PageHero
    lines={['An IT department', 'for your business.']}
    support="Networks, cameras, cabling, Microsoft 365 and AV for businesses without an IT person. Designed, installed and then actually managed."
    primary={{ href: managedSurvey, label: 'Book a free site survey' }}
    secondary={{ href: site.phoneHref, label: `Call ${site.phone}` }}
  />

  <BigList
    heading="Who I work with"
    items={industries.map((i) => ({ title: i.name, desc: i.installs.slice(0, 2).join('. ') + '.', href: `/business/${i.slug}/` }))}
  />

  <section class="chapter bg-cream text-espresso" data-field="#f7f0e0" data-ink="#3b1005">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">Install once. Managed always.</h2>
      <p class="intro-lead mt-6">Everything here is available as a one-time project or under a monthly plan.</p>
      <div class="spec-grid">
        {
          capabilities.map((c) => (
            <div data-reveal>
              <h3 class="font-display">{c.title}</h3>
              <p>{c.body}</p>
              {c.slug && <a href={`/business/${c.slug}/`}>More on this</a>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ClosetPair />

  <section class="chapter bg-espresso text-cream" data-field="#3b1005" data-ink="#f7f0e0" id="care-plans">
    <div class="page-wrap section-pad">
      <h2 class="font-display h-section">Pick a plan. Forget about IT.</h2>
      <p class="intro-lead mt-6">Monthly plans with one local person who answers. Custom-quoted to your site after a free survey.</p>
      <div class="plans">
        {
          carePlans.map((plan) => (
            <div data-reveal>
              <h3 class={`font-display plan-name ${plan.popular ? 'plan-mark' : ''}`}>{plan.name}</h3>
              <p class="plan-tag">
                {plan.tagline}
                {plan.popular ? ' Recommended for most sites.' : ''}
              </p>
              <ul class="plan-list">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="plans-note">
        <p>Month to month, no long contracts. The plan earns its keep or you cancel.</p>
        <a href={managedSurvey} class="btn-flat">Start with a site survey</a>
      </div>
    </div>
  </section>

  <OwnerPanel
    reasons={[
      { title: 'One vendor for AV and IT', body: 'TVs, sound, Wi-Fi, cameras and Microsoft 365 from one person, so nobody points at another vendor when something breaks.' },
      { title: 'Owner-operated', body: 'No call center and no subcontractor roulette. You get my cell number.' },
      { title: 'Month to month', body: 'Care plans have no long contract. They earn their keep or you cancel.' },
    ]}
  />

  <PictureBand />

  <Staircase />

  <Letter field="cream" />

  <CtaBand line1="Let's look at" line2="your building." href={managedSurvey} />
</Layout>
