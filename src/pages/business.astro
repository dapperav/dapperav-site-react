---
/** Business hub: who we work with, what we run, the care plans. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FilmScene from '../components/FilmScene.astro';
import IndustryLedger from '../components/IndustryLedger.astro';
import Steps from '../components/Steps.astro';
import DocMap from '../components/DocMap.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, carePlans, support } from '../data/site';

const managedSurvey = `/quote/?service=${encodeURIComponent('Managed IT / Networking (Business)')}`;

---

<Layout
  title="Managed IT, Networks & Commercial AV | Dapper AV"
  description="An IT department for Fort Bend County businesses: UniFi networks and cameras, cabling, Microsoft 365 and commercial AV. Installed, then managed."
>
  <Hero
    lead="Managed IT, networks and commercial AV"
    main="Your IT department."
    lede="Wi-Fi, cameras, cabling, Microsoft 365 and AV for Fort Bend County restaurants, offices and shops. Designed, installed around your hours and supported when something breaks."
    actions={[
      { href: managedSurvey, label: 'Book a free site survey', arrow: true },
      { href: '#care-plans', label: 'See care plans', variant: 'ghost' },
    ]}
  >
    <p class="hero-aside">Care plans are month to month. Pricing is custom-quoted after the free survey. <a class="text-link" href="#care-plans">See the three plans</a>.</p>
    <div slot="aside" class="hero-card">
      <FilmScene kind="office" credit="Managed IT" label="Illustration: an office where the Wi-Fi comes on and the spinner turns into a check" />
    </div>
  </Hero>

  <section class="section" id="industries" aria-labelledby="industries-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2 class="h2" id="industries-title">Who we work with</h2>
          <p class="lede">Six kinds of business, each with its own page: what we install there, what moves the price and what owners ask first.</p>
        </div>
      </div>
      <IndustryLedger />
    </div>
  </section>

  <section class="section on-dark pinstripe" id="care-plans" aria-labelledby="plans-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="plans-title">A care plan built around your site</h2>
        <p class="lede">Every site is different, so every plan is too. After the free survey we put together what your building needs from the list below, priced in writing and month to month.</p>
      </div>
      <div class="bezel bezel--dark plan-panel" data-reveal>
        <div class="bezel-core">
          {
            carePlans.map((plan) => (
              <div class="plan">
                <h3 class="plan-name">{plan.name}</h3>
                <ul class="checklist">
                  {plan.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="support" data-reveal>
        <h3 class="support-title">How support works</h3>
        <ul class="support-list">
          <li><strong>{support.channels}</strong></li>
          <li>Support hours: {support.hours}.</li>
          <li>{support.emergency}</li>
        </ul>
      </div>
      <div class="plan-foot">
        <p>Month to month. No long contract.</p>
        <a class="btn btn--primary btn--lg" href={managedSurvey}>Book a free site survey</a>
      </div>
    </div>
  </section>

  <section class="section on-dark pinstripe" id="process" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="process-title">How a business job goes</h2>
        <p class="lede">Scheduled around your hours: before open, after close or on a weekend.</p>
      </div>
      <Steps />
    </div>
  </section>

  <DocMap />

  <Reviews mode="one" author="Micaela" heading="A business review on Google" alt />

  <CtaBand title="Let's look at your building" href={managedSurvey} />
</Layout>
