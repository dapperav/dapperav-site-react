---
/** Business hub: who I work with, what I run, the care plans, then the person behind it. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import GearPhoto from '../components/GearPhoto.astro';
import IndustryLedger from '../components/IndustryLedger.astro';
import Owner from '../components/Owner.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, carePlans } from '../data/site';

const managedSurvey = `/quote/?service=${encodeURIComponent('Managed IT / Networking (Business)')}`;

const capabilities = [
  {
    title: 'Business networks on UniFi',
    body: 'Switches, access points and cabling designed for your floor plan, installed clean and documented properly.',
    slug: 'networks-wifi',
    more: 'Business Wi-Fi & networks',
  },
  {
    title: 'Cameras you own',
    body: 'UniFi Protect cameras with local recording and phone viewing. No monthly per-camera cloud fees.',
  },
  {
    title: 'Security and separate networks',
    body: 'Firewall rules and VLANs that keep the POS, cameras, staff and guests apart, with dedicated Wi-Fi for each.',
  },
  {
    title: 'Microsoft 365',
    body: 'Tenant setup, migrations and day-to-day users, licenses and email, done right from the start.',
    slug: 'offices-conference-rooms',
    more: 'Offices & conference rooms',
  },
  {
    title: 'Cabling and low voltage',
    body: 'Data drops, racks and the rough-in for new builds and remodels, as your sub or direct.',
    slug: 'structured-cabling',
    more: 'Structured cabling',
  },
  {
    title: 'Commercial AV',
    body: 'Video walls, signage, conference rooms and bar TVs, serviced by the same person who runs your network.',
    slug: 'restaurants-bars',
    more: 'Restaurants & bars',
  },
];
---

<Layout
  title="Managed IT, Networks & Commercial AV | Dapper AV"
  description="An IT department for Fort Bend County businesses: UniFi networks and cameras, cabling, Microsoft 365 and commercial AV. Installed, then managed."
>
  <Hero
    lead="Managed IT, networks and commercial AV"
    main="An IT department for your business."
    lede="Networks, cameras, cabling, Microsoft 365 and AV for businesses without an IT person. Designed, installed and then actually managed, by an IT director who answers his own phone."
    actions={[
      { href: managedSurvey, label: 'Book a free site survey', arrow: true },
      { href: site.phoneHref, label: `Call ${site.phone}`, variant: 'ghost' },
    ]}
  >
    <p class="hero-aside">Care plans are month to month and custom-quoted after the survey. <a class="text-link" href="#care-plans">See the three plans</a>.</p>
    <div slot="aside" class="bezel bezel--dark hero-card">
      <GearPhoto item="ap" shape="tall" reveal={false} sizes="(min-width: 1024px) 30vw, 90vw" />
    </div>
  </Hero>

  <section class="section" id="industries" aria-labelledby="industries-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <h2 class="h2" id="industries-title">Who I work with</h2>
          <p class="lede">Six kinds of business, each with its own page: what I install there, what moves the price and what owners ask first.</p>
        </div>
      </div>
      <IndustryLedger />
    </div>
  </section>

  <section class="section section--alt grooves" id="capabilities" aria-labelledby="capabilities-title">
    <div class="container split">
      <div class="split-head">
        <h2 class="h2" id="capabilities-title">Install once. Managed always.</h2>
        <p class="lede">Everything here is available as a one-time project or under a monthly plan.</p>
      </div>
      <dl class="defs defs--two">
        {
          capabilities.map((c) => (
            <div data-reveal>
              <dt>{c.title}</dt>
              <dd>
                {c.body}
                {c.slug && (
                  <>
                    <br />
                    <a class="text-link" href={`/business/${c.slug}/`}>
                      {c.more}
                    </a>
                  </>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section on-dark pinstripe" id="care-plans" aria-labelledby="plans-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="plans-title">Pick a plan. Forget about IT.</h2>
        <p class="lede">Monthly plans with one local person who answers. Custom-quoted to your site after a free survey, so there are no prices here to guess from.</p>
      </div>
      <div class="bezel bezel--dark plan-panel" data-reveal>
        <div class="bezel-core">
          {
            carePlans.map((plan) => (
              <div class:list={['plan', { 'plan--marked': plan.popular }]}>
                <h3 class="plan-name">{plan.name}</h3>
                <p class="plan-tag">{plan.tagline}</p>
                {plan.popular && <p class="plan-flag">Recommended for most sites</p>}
                <ul class="checklist">
                  {plan.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div class="plan-foot">
        <p>Month to month, no long contracts. The plan earns its keep or you cancel.</p>
        <a class="btn btn--primary btn--lg" href={managedSurvey}>Start with a site survey</a>
      </div>
    </div>
  </section>

  <Owner
    heading="One person for AV and IT"
    lede="I'm Mark Immler. I've installed AV for 18 years and run managed IT for five, and I'm an IT director by day. You get my cell number, not a ticket queue."
    reasons={[
      { title: 'One vendor for AV and IT', body: 'TVs, sound, Wi-Fi, cameras and Microsoft 365 from one person, so nobody points at another vendor when something breaks.' },
      { title: 'Owner-operated', body: 'No call center and no subcontractor roulette. The person who surveys is the person who installs.' },
      { title: 'Month to month', body: 'Care plans have no long contract. They earn their keep or you cancel.' },
    ]}
  />

  <section class="section on-dark pinstripe" id="process" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="process-title">How a business job goes</h2>
        <p class="lede">Scheduled around your hours: before open, after close or on a weekend.</p>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section" aria-labelledby="standard-title">
    <div class="container standard standard--flip">
      <GearPhoto item="switch" sizes="(min-width: 1024px) 55vw, 100vw" />
      <div>
        <h2 class="h2" id="standard-title">What you get at closeout</h2>
        <p class="lede">A network you can hand to anyone: labeled cables, separated traffic, and notes on what went where. Then a care plan, if you want one, so it stays that way.</p>
        <div class="stack-actions">
          <a class="btn btn--secondary" href={managedSurvey}>Book a free site survey</a>
          <a class="text-link" href="/business/networks-wifi/">How I build business networks</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews mode="one" author="Micaela" heading="A business review on Google" alt />

  <CtaBand title="Let's look at your building" href={managedSurvey} />
</Layout>
